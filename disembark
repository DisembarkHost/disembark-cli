    private static function load_config($url) {
        // Standardize URL
        self::$siteUrl = rtrim($url, '/');
        if (!preg_match('/^https?:\/\//', self::$siteUrl)) {
            self::$siteUrl = "https://" . self::$siteUrl;
        }

        // Find Token
        $homeDir = getenv('HOME');
        if (!$homeDir) {
            echo "Error: Unable to determine the home directory.\n";
            exit(1);
        }

        $filePath = $homeDir . '/.disembark';
        if (!file_exists($filePath)) {
            echo "Error: No configuration file found at $filePath.\n";
            exit(1);
        }

        $data = json_decode(file_get_contents($filePath));
        if (!is_array($data)) $data = is_object($data) ? [$data] : [];

        foreach ($data as $entry) {
            if (is_object($entry) && isset($entry->siteUrl) && $entry->siteUrl === self::$siteUrl) {
                // Load both credential kinds when present: after a restore the
                // application password is gone (the import replaced wp_users)
                // but the pinned site token still works — --rollback relies on
                // it. make_request sends whichever it has.
                if (!empty($entry->username) && isset($entry->password)) {
                    self::$username = $entry->username;
                    self::$password = $entry->password;
                }
                if (!empty($entry->token)) {
                    self::$token = $entry->token;
                }
                if (!empty($entry->rest_style)) {
                    self::$rest_style = $entry->rest_style;
                }
                return;
            }
        }

        echo "Error: No credentials found for " . self::$siteUrl . ".\n";
        exit(1);
    }

    private static function convert_to_bytes($size_str) {
        $size_str = strtolower(trim($size_str));
        
        // Use preg_match to separate the number and the unit
        preg_match('/^([0-9\.]+)\s*(kb|mb|gb|k|m|g)?$/', $size_str, $matches);
        
        $value = isset($matches[1]) ? (float) $matches[1] : 0;
        $unit = isset($matches[2]) ? $matches[2] : '';

        switch ($unit) {
            case 'g':
            case 'gb':
                $value *= 1024 * 1024 * 1024;
                break;
            case 'm':
            case 'mb':
                $value *= 1024 * 1024;
                break;
            case 'k':
            case 'kb':
                $value *= 1024;
                break;
        }
        return (int) $value;
    }

    /**
     * Convert bytes to human-readable format.
     */
    private static function humanFilesize($bytes, $decimals = 2) {
        if ($bytes === null) return '0 B';
        if (!is_numeric($bytes)) return 'N/A';

        $bytesNum = (float) $bytes;

        if ($bytesNum == 0) return '0 B';

        $factor = floor(log($bytesNum, 1024));
        $sz = 'BKMGTP';
        $max_factor = strlen($sz) - 1;

        $factor = max(0, min((int)$factor, $max_factor));

        $size_str = sprintf("%.{$decimals}f", $bytesNum / pow(1024, $factor));
        $unit = $sz[$factor];
        $suffix = ($factor > 0) ? 'B' : '';

        return $size_str . ' ' . $unit . $suffix;
    }

    /**
     * Downloads a file using native cURL.
     * Supports standard verbose output or a custom progress bar label.
     */
    private static function download_file_direct($url, $destination, $progress_label = null) {
        $attempts = 0;
        $max_attempts = 5;
        $last_error = '';

        // Written beside the destination and moved over it only when whole,
        // so a failed download never empties a good copy already there.
        $part = $destination . '.part';
        $wait = 2;

        while ($attempts < $max_attempts) {
            $attempts++;
            $fp = false;
            $ch = false;
            $retry_after = null;
            
            $previous_downloaded = 0;
            $has_printed_lines = false;

            try {
                if (is_link($part)) @unlink($part);
                $fp = fopen($part, 'w+');
                if ($fp === false) throw new \Exception("Could not open $part");

                $ch = curl_init($url);
                curl_setopt($ch, CURLOPT_FILE, $fp);
                curl_setopt($ch, CURLOPT_HEADERFUNCTION, function ($c, $line) use (&$retry_after) {
                    if (stripos($line, 'retry-after:') === 0) {
                        $retry_after = trim(substr($line, 12));
                    }
                    return strlen($line);
                });
                curl_setopt($ch, CURLOPT_TIMEOUT, 3600);
                curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
                if (self::$cookie) {
                    curl_setopt($ch, CURLOPT_COOKIE, self::$cookie);
                }
                curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
                curl_setopt($ch, CURLOPT_USERAGENT, self::$user_agent);
                curl_setopt($ch, CURLOPT_NOPROGRESS, false);
                curl_setopt($ch, CURLOPT_PROGRESSFUNCTION, function(
                    $resource, $download_size, $downloaded, $upload_size, $uploaded
                ) use ($attempts, $max_attempts, &$previous_downloaded, &$has_printed_lines, $progress_label) {
                    
                    $percent = ($download_size > 0) ? round(($downloaded / $download_size) * 100) : 0;
                    
                    // Global Stats Update
                    if (self::$global_bytes_total > 0) {
                        $delta = $downloaded - $previous_downloaded;
                        if ($delta > 0) {
                            self::$global_bytes_processed += $delta;
                            $previous_downloaded = $downloaded;
                        }
                    }

                    // Prepare Global Line (Footer)
                    $global_line = "";
                    if (self::$global_bytes_total > 0) {
                        $g_cur = self::humanFilesize(self::$global_bytes_processed);
                        $g_tot = self::humanFilesize(self::$global_bytes_total);
                        $g_perc = (self::$global_bytes_total > 0) ? round((self::$global_bytes_processed / self::$global_bytes_total) * 100) : 0;
                        $global_line = "$g_cur / $g_tot ($g_perc%)";
                    }

                    // Prepare File Line (Main Output)
                    $file_line = "";
                    if ($progress_label) {
                        // --- BAR MODE ---
                        // Pad label to align bars (adjust 60 to fit your preferred width)
                        $padded_label = str_pad($progress_label, 60);
                        $bar = self::draw_progress_bar($downloaded, $download_size, 15);
                        $size_str = self::humanFilesize($downloaded);
                        $file_line = "\r\033[K{$padded_label} {$bar} {$size_str}";
                    } else {
                        // --- STANDARD MODE ---
                        $d_human = self::humanFilesize($downloaded);
                        $t_human = ($download_size > 0) ? self::humanFilesize($download_size) : 'Unknown';
                        $prefix = ($attempts > 1) ? "[Retry $attempts] " : "";
                        $file_line = "\r\033[K     - {$prefix}Downloading: $d_human / $t_human ($percent%)...";
                    }

                    // Render
                    echo $file_line;

                    if ($global_line) {
                        echo "\n\033[K" . $global_line; 
                        echo "\033[1A"; 
                    }

                    $has_printed_lines = true;
                });

                $data = curl_exec($ch);
                $error = curl_error($ch);
                $statusCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
                $expected = curl_getinfo($ch, CURLINFO_CONTENT_LENGTH_DOWNLOAD);
                
                if (is_resource($ch)) curl_close($ch);
                $written = is_resource($fp) ? (fflush($fp) && fclose($fp)) : true;

                if (!$data) throw new \Exception("cURL Error: $error");
                if ($statusCode == 429 || $statusCode == 503) {
                    $wait = self::retry_wait((object) ['headers' => $retry_after !== null ? ['retry-after' => $retry_after] : []], $attempts);
                    throw new \Exception("HTTP Error $statusCode (the host asked to slow down)");
                }
                if ($statusCode >= 400) throw new \Exception("HTTP Error $statusCode");
                clearstatcache(true, $part);
                if (!$written) throw new \Exception("Could not write the download to disk (is it full?)");
                if ($expected > 0 && filesize($part) !== (int) $expected) {
                    throw new \Exception("Short download: " . filesize($part) . " of " . (int) $expected . " bytes");
                }
                if (!rename($part, $destination)) throw new \Exception("Could not move the download into place at $destination");

                // Cleanup Output
                if ($has_printed_lines) {
                    if ($progress_label) {
                        // Bar Mode: Move to next line (footer line).
                        echo "\n";
                    } else {
                        // Standard Mode: Replace progress with "Complete" message
                        echo "\r\033[K";
                        echo "     - Download complete.\n";
                        // Restore global footer logic
                        if (self::$global_bytes_total > 0) {
                            $g_cur = self::humanFilesize(self::$global_bytes_processed);
                            $g_tot = self::humanFilesize(self::$global_bytes_total);
                            $g_perc = round((self::$global_bytes_processed / self::$global_bytes_total) * 100);
                            echo "\033[K$g_cur / $g_tot ($g_perc%)\r";
                        } else {
                            echo "\r\033[K\033[1A";
                        }
                    }
                } else if ($progress_label) {
                     echo "\n";
                } else {
                    echo "     - Download complete.\n";
                }
                return;

            } catch (\Exception $e) {
                if (is_resource($ch)) curl_close($ch);
                if (is_resource($fp)) fclose($fp);
                @unlink($part);
                if ($has_printed_lines) {
                    // Cleanup visual artifacts before printing error
                     if ($progress_label) echo "\n\033[K"; 
                     else echo "\n\r\033[K\033[1A\r\033[K";
                }

                if ($attempts < $max_attempts) {
                    echo "     - Warning: Download failed: {$e->getMessage()}. Retrying in {$wait}s...\n";
                    sleep($wait);
                    $wait = min(60, max(2, $attempts * 2));
                } else {
                    $last_error = $e->getMessage();
                }
            }
        }
        throw new \Exception("Download failed: $last_error");
    }

    /**
     * Downloads large files using a rolling queue with Multi-line Progress Bars + Global Footer.
     * Includes size validation and fallback to stream API.
     */
    private static function download_files_parallel($files, $folder) {
        // One site of a network or WP Freighter install: the list names its
        // files as the export does (its uploads as wp-content/uploads), and
        // that public address would serve the main site's file or none. Each
        // comes through /stream-file, which looks the real one up.
        if (self::scoped_source()) {
            $failed_before = count(self::$failures);
            foreach ($files as $file) {
                $local_dest = $folder . '/' . $file->name;
                if (!is_dir(dirname($local_dest))) {
                    @mkdir(dirname($local_dest), 0755, true);
                }
                echo "    > Streaming {$file->name} (" . self::humanFilesize($file->size) . ")...\n";
                try {
                    self::download_file_chunked_stream($file->name, $local_dest, $file->size);
                    self::$global_bytes_processed += (int) $file->size;
                } catch (\Exception $e) {
                    echo "      Error: " . $e->getMessage() . "\n";
                    self::$failures[] = "{$file->name} (download failed)";
                }
            }
            echo " - All large file downloads processed" . (count(self::$failures) > $failed_before ? ' (with errors)' : '') . ".\n";
            return;
        }
        $max_concurrency = 4;
        $max_retries = 3; 
        $mh = curl_multi_init();

        $queue = [];
        foreach ($files as $f) {
            $queue[] = ['file' => $f, 'attempts' => 0];
        }

        $active_transfers = []; 
        $slots = array_fill(0, $max_concurrency, null); 
        $total_files = count($files);
        $processed_count = 0;
        $fallback_queue = []; 

        // Hide Cursor
        echo "\033[?25l";
        echo " - Starting threaded download of {$total_files} large files...\n";
        // Reserve space: Concurrency lines + 1 extra line for Global Footer
        echo str_repeat("\n", $max_concurrency + 1);
        echo "\033[" . ($max_concurrency + 1) . "A"; // Move cursor up

        do {
            // 1. REFILL QUEUE
            while (count($active_transfers) < $max_concurrency && !empty($queue)) {
                $slot_index = array_search(null, $slots);
                if ($slot_index === false) break;

                $item = array_shift($queue);
                $file = $item['file'];
                $item['attempts']++;

                $local_dest = $folder . '/' . $file->name;
                $local_dir = dirname($local_dest);
                if (!is_dir($local_dir)) @mkdir($local_dir, 0755, true);
                
                $path_parts = explode('/', $file->name);
                $encoded_parts = array_map('rawurlencode', $path_parts);
                $url = self::$siteUrl . '/' . implode('/', $encoded_parts);
                
                // Into <file>.part, moved over the file only once whole, so
                // a failed download never empties the copy already there.
                if (is_link($local_dest . '.part')) @unlink($local_dest . '.part');
                $fp = fopen($local_dest . '.part', 'w+');
                if (!$fp) {
                    $line_offset = $slot_index + 1;
                    echo "\033[{$line_offset}B\033[KError: Could not open $local_dest.part\r\033[{$line_offset}A";
                    self::$failures[] = "{$file->name} (could not open the local file)";
                    $processed_count++;
                    continue;
                }

                $ch = curl_init($url);
                curl_setopt($ch, CURLOPT_FILE, $fp);
                curl_setopt($ch, CURLOPT_TIMEOUT, 3600);
                if (self::$cookie) {
                    curl_setopt($ch, CURLOPT_COOKIE, self::$cookie);
                }
                curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
                curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
                curl_setopt($ch, CURLOPT_NOPROGRESS, true);
                curl_setopt($ch, CURLOPT_USERAGENT, self::$user_agent);

                curl_multi_add_handle($mh, $ch);
                $ch_int = (int)$ch;
                $active_transfers[$ch_int] = [
                    'handle'  => $ch, 
                    'wrapper' => $item,
                    'fp'      => $fp,
                    'slot'    => $slot_index
                ];
                $slots[$slot_index] = $ch_int;
            }

            // 2. EXECUTE
            $status = curl_multi_exec($mh, $running);
            if ($running > 0) {
                curl_multi_select($mh, 0.1);
            }

            // 3. UPDATE UI
            $current_batch_bytes = 0; // Bytes currently downloading in this loop

            foreach ($active_transfers as $ch_int => $data) {
                $slot = $data['slot'];
                $line_offset = $slot + 1;
                $label_num = $slot + 1;

                $name_parts = explode('/', $data['wrapper']['file']->name);
                $count = count($name_parts);
                $filename = ($count > 1) ? $name_parts[$count-2] . '/' . $name_parts[$count-1] : $name_parts[0];
                $downloaded = curl_getinfo($data['handle'], CURLINFO_SIZE_DOWNLOAD);
                $total = $data['wrapper']['file']->size; 
                
                // Add to current batch accumulator for the footer
                $current_batch_bytes += $downloaded;
                if (strlen($filename) > 56) $filename = '...' . substr($filename, -53);
                $filename_padded = str_pad($filename, 56);
                $bar = self::draw_progress_bar($downloaded, $total, 15);
                $size_str = self::humanFilesize($downloaded);
                
                echo "\033[{$line_offset}B\r\033[K {$label_num}: {$filename_padded} {$bar} {$size_str}\033[{$line_offset}A";
            }

            // 4. UPDATE GLOBAL FOOTER
            // Only display if we have a total calculated
            if (self::$global_bytes_total > 0) {
                // Total Processed = (Files Finished) + (Active Download Progress)
                $display_current = self::$global_bytes_processed + $current_batch_bytes;
                // Cap at total to prevent minor overflows from confusing the user
                if ($display_current > self::$global_bytes_total) $display_current = self::$global_bytes_total;
                $human_current = self::humanFilesize($display_current);
                $human_total = self::humanFilesize(self::$global_bytes_total);
                
                // Avoid division by zero
                $global_percent = (self::$global_bytes_total > 0) ? round(($display_current / self::$global_bytes_total) * 100) : 0;
                $footer_offset = $max_concurrency + 1;
                
                // Print Footer: Flush left, no label
                echo "\033[{$footer_offset}B\r\033[K{$human_current} / {$human_total} ({$global_percent}%)\033[{$footer_offset}A";
            }

            // 5. CHECK COMPLETION
            while ($info = curl_multi_info_read($mh)) {
                $ch = $info['handle'];
                $ch_id = (int)$ch;
                
                if (isset($active_transfers[$ch_id])) {
                    $transfer = $active_transfers[$ch_id];
                    $slot = $transfer['slot'];
                    $wrapper = $transfer['wrapper'];
                    $file = $wrapper['file'];
                    
                    $curl_info = curl_getinfo($ch);
                    
                    curl_multi_remove_handle($mh, $ch);
                    if (is_resource($ch)) {
                        curl_close($ch);
                    }
                    $written = fflush($transfer['fp']) && fclose($transfer['fp']);
                    unset($active_transfers[$ch_id]);
                    $slots[$slot] = null;

                    // Validation
                    $local_dest = $folder . '/' . $file->name;
                    $part = $local_dest . '.part';
                    clearstatcache(true, $part);
                    $actual_size = file_exists($part) ? filesize($part) : 0;
                    $expected_size = (int)$file->size;
                    
                    $is_http_error = $curl_info['http_code'] >= 400;
                    $is_curl_error = $info['result'] !== CURLE_OK || !$written;
                    $is_size_mismatch = $actual_size !== $expected_size;
                    if (!$is_http_error && !$is_curl_error && !$is_size_mismatch && !rename($part, $local_dest)) {
                        $is_curl_error = true;
                    }

                    if ($is_http_error || $is_curl_error || $is_size_mismatch) {
                        @unlink($part);
                        // Fail Fast or Retry logic
                        if ($is_http_error) {
                             $fallback_queue[] = $file;
                             $line_offset = $slot + 1;
                             echo "\033[{$line_offset}B\r\033[K {$slot}: -> HTTP {$curl_info['http_code']}. Queuing fallback...\033[{$line_offset}A";
                             $processed_count++;
                        } 
                        else if ($wrapper['attempts'] < $max_retries) {
                            array_push($queue, $wrapper);
                        } 
                        else {
                            $fallback_queue[] = $file;
                            $line_offset = $slot + 1;
                            echo "\033[{$line_offset}B\r\033[K {$slot}: -> Retries exhausted. Queuing fallback...\033[{$line_offset}A";
                            $processed_count++;
                        }
                    } else {
                        // SUCCESS: Permanently add this file's full size to global stats
                        self::$global_bytes_processed += $expected_size;
                        $processed_count++;
                    }
                }
            }

        } while ($running > 0 || !empty($queue));

        // CLEANUP: 
        // 1. Move cursor down from Top (where it sits during loop) to the Global Footer line
        $lines_to_move = $max_concurrency + 1;
        echo "\033[{$lines_to_move}B";
        
        // 2. Clear the Footer line completely so it doesn't get stuck
        echo "\r\033[K"; 
        
        // 3. Show cursor (It is now sitting on the empty line below the file list)
        echo "\033[?25h";

        // 6. PROCESS FALLBACKS
        if (!empty($fallback_queue)) {
            echo " - Processing " . count($fallback_queue) . " failed downloads via stream fallback...\n";
            foreach ($fallback_queue as $file) {
                $local_dest = $folder . '/' . $file->name;
                $human_size = self::humanFilesize($file->size);
                echo "    > Streaming {$file->name} ($human_size)...\n";
                try {
                    // Note: Stream fallback handles its own progress bar
                    self::download_file_chunked_stream($file->name, $local_dest, $file->size);
                    
                    // Success on stream: Add to global stats
                    self::$global_bytes_processed += (int)$file->size;
                } catch (\Exception $e) {
                    echo "      Error: " . $e->getMessage() . "\n";
                    self::$failures[] = "{$file->name} (download failed)";
                }
            }
        }

        echo " - All large file downloads processed.\n";
    }

    /**
     * Fetches manifest chunks in parallel using a rolling queue.
     * Returns the aggregated remote files map.
     */
    private static function fetch_manifests_parallel($manifest_chunks) {
        $max_concurrency = 8;
        $max_retries = 5;
        $mh = curl_multi_init();
        $queue = [];

        // What the source listed, and whether the list is whole. Sync only
        // deletes when it is: a chunk that can't be fetched, doesn't decode,
        // or holds fewer files than the source counted means "unknown", never
        // "deleted on the source".
        $listed   = [];
        $problems = [];

        // Filter valid chunks and prepare queue
        foreach ((array) $manifest_chunks as $chunk) {
            if (is_object($chunk) && isset($chunk->url)) {
                $queue[] = ['chunk' => $chunk, 'attempts' => 0];
            } else {
                $problems[] = "a manifest chunk without a URL";
            }
        }

        $active_transfers = [];
        $total_chunks = count($queue);
        $processed_count = 0;
        $remote_files_map = [];
        $all_remote_files = [];
        $failed_chunks = [];

        echo " - Fetching $total_chunks manifest chunks (Concurrency: $max_concurrency)...\n";
        do {
            // 1. REFILL
            while (count($active_transfers) < $max_concurrency && !empty($queue)) {
                $item = array_shift($queue);
                $chunk = $item['chunk'];
                $item['attempts']++;

                $ch = curl_init($chunk->url);
                curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
                curl_setopt($ch, CURLOPT_TIMEOUT, 60);
                curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 20);
                curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
                if (self::$cookie) {
                    curl_setopt($ch, CURLOPT_COOKIE, self::$cookie);
                }
                curl_setopt($ch, CURLOPT_USERAGENT, self::$user_agent);
                curl_multi_add_handle($mh, $ch);
                $ch_id = is_object($ch) ? spl_object_id($ch) : (int) $ch;
                $active_transfers[$ch_id] = ['wrapper' => $item];
            }

            // 2. EXECUTE
            curl_multi_exec($mh, $running);
            if ($running > 0) curl_multi_select($mh);

            // 3. CHECK COMPLETION
            while ($info = curl_multi_info_read($mh)) {
                $ch = $info['handle'];
                $ch_id = is_object($ch) ? spl_object_id($ch) : (int) $ch;
                
                if (isset($active_transfers[$ch_id])) {
                    $transfer = $active_transfers[$ch_id];
                    $chunk_name = $transfer['wrapper']['chunk']->name ?? 'unknown';
                    
                    $content = curl_multi_getcontent($ch);
                    $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
                    $error = curl_error($ch);

                    curl_multi_remove_handle($mh, $ch);
                    unset($active_transfers[$ch_id]);

                    $absorbed = ($http_code === 200 && !$error && !empty($content))
                        && self::absorb_manifest_chunk($transfer['wrapper']['chunk'], $content, $remote_files_map, $listed, $problems, false);

                    if (!$absorbed) {
                        // FAILURE
                        if ($transfer['wrapper']['attempts'] < $max_retries) {
                            echo ".";
                            array_push($queue, $transfer['wrapper']);
                        } else {
                            echo "\n   - Warning: Failed to download manifest chunk $chunk_name after $max_retries attempts.\n";
                            
                            if (self::$debug) {
                                $url = $transfer['wrapper']['chunk']->url ?? 'Unknown URL';
                                echo "     [DEBUG] URL: $url\n";
                                echo "     [DEBUG] HTTP Code: $http_code\n";
                                echo "     [DEBUG] cURL Error: " . ($error ?: 'None') . "\n";
                                if ($http_code !== 200 && !empty($content)) {
                                     // Show a snippet of the body in case it contains a server error message
                                     echo "     [DEBUG] Body Preview: " . substr(strip_tags($content), 0, 200) . "\n";
                                }
                            }

                            $failed_chunks[] = $transfer['wrapper']['chunk']; // Queue for fallback
                            $processed_count++;
                        }
                    } else {
                        $processed_count++;
                        // Progress indicator
                        if ($processed_count % 10 === 0 || $processed_count === $total_chunks) {
                            $percent = round(($processed_count / $total_chunks) * 100);
                            echo "     Progress: $processed_count/$total_chunks ($percent%)\r";
                        }
                    }
                }
            }
        } while ($running > 0 || !empty($queue) || !empty($active_transfers));

        curl_multi_close($mh);

        if (!empty($failed_chunks)) {
            echo "\n - Attempting fallback stream download for " .
            count($failed_chunks) . " failed chunks...\n";
            
            foreach ($failed_chunks as $chunk) {
                $chunk_label = $chunk->name ?? ($chunk->path ?? 'unknown');
                if (empty($chunk->path)) {
                    $problems[] = "manifest chunk $chunk_label could not be fetched";
                    continue;
                }
                // Determine temp path for this chunk
                $temp_manifest_path = sys_get_temp_dir() . '/disembark-manifest-' . self::new_session_id() . '.json';
                
                try {
                    echo "   > Streaming manifest: {$chunk->path}\n";
                    // Reuse existing robust stream downloader
                    self::download_file_via_stream($chunk->path, $temp_manifest_path);
                    $content = file_exists($temp_manifest_path) ? file_get_contents($temp_manifest_path) : '';
                    @unlink($temp_manifest_path);
                    $before = count($remote_files_map);
                    if (self::absorb_manifest_chunk($chunk, $content, $remote_files_map, $listed, $problems, true)) {
                        echo "     - Recovered " . (count($remote_files_map) - $before) . " files from stream.\n";
                    } else {
                        echo "     - Failed to read the manifest chunk from the stream.\n";
                    }
                } catch (\Exception $e) {
                    @unlink($temp_manifest_path);
                    $problems[] = "manifest chunk $chunk_label could not be fetched";
                    echo "     - Critical: Fallback failed for {$chunk_label}. {$e->getMessage()}\n";
                }
            }
        }

        echo "\n - Manifest download complete.\n";
        $report = [
            'complete' => empty($problems),
            'problems' => array_values(array_unique($problems)),
            'listed'   => $listed,
        ];
        return [$remote_files_map, $all_remote_files, $report];
    }

    /**
     * Reads one manifest chunk into the remote file map. True when the chunk
     * decoded to a list holding as many entries as the source counted for it.
     * With $final false, a bad chunk is left for a retry without being
     * recorded as a problem; with $final true it is recorded.
     */
    private static function absorb_manifest_chunk($chunk, $content, &$remote_files_map, &$listed, &$problems, $final) {
        $label = $chunk->name ?? 'unknown';
        $files = json_decode((string) $content);
        if (!is_array($files)) {
            if ($final) {
                $problems[] = "manifest chunk $label is not a file list";
            }
            return false;
        }
        if (isset($chunk->count) && is_numeric($chunk->count) && count($files) !== (int) $chunk->count) {
            if ($final) {
                $problems[] = "manifest chunk $label lists " . count($files) . " of {$chunk->count} files";
            }
            return false;
        }
        foreach ($files as $file) {
            if (!is_object($file) || !isset($file->name) || !is_string($file->name) || $file->name === '') continue;
            $listed[$file->name] = true;
            // Apply exclusions using static property
            if (self::is_excluded($file->name)) continue;
            $remote_files_map[$file->name] = $file;
        }
        return true;
    }

    /** True when $path is one of the -x paths or inside one. */
    private static function is_excluded($path) {
        foreach (self::$exclude_paths as $exclude_path) {
            if ($path === $exclude_path || strpos($path, $exclude_path . '/') === 0) {
                return true;
            }
        }
        return false;
    }

    /**
     * True for a relative path that names something inside a folder: no
     * leading slash or drive, no "." or ".." segment, no empty segment, no
     * backslash or NUL. Source file names are checked with this before
     * anything is written or deleted for them.
     */
    private static function is_safe_relative_path($name) {
        if (!is_string($name) || $name === '' || strpos($name, "\0") !== false || strpos($name, '\\') !== false) {
            return false;
        }
        if ($name[0] === '/' || preg_match('#^[A-Za-z]:#', $name)) {
            return false;
        }
        foreach (explode('/', $name) as $segment) {
            if ($segment === '' || $segment === '.' || $segment === '..') {
                return false;
            }
        }
        return true;
    }

    /**
     * True when $rel can be written or deleted under $root without leaving
     * it: a safe relative path, and no part of it that exists locally is a
     * symlink (or a file where a folder is needed). Missing parts are fine:
     * they're created as real folders.
     */
    private static function local_path_safe($root, $rel) {
        $real_root = realpath($root);
        if ($real_root === false || !self::is_safe_relative_path($rel)) {
            return false;
        }
        $parts = explode('/', $rel);
        $last  = count($parts) - 1;
        $path  = $real_root;
        foreach ($parts as $i => $segment) {
            $path .= DIRECTORY_SEPARATOR . $segment;
            if (is_link($path)) {
                return false;
            }
            if (!file_exists($path)) {
                return true;
            }
            if ($i < $last && !is_dir($path)) {
                return false;
            }
        }
        return true;
    }

    /**
     * Sync's own files at the mirror's root, which a source file of the same
     * name must never overwrite (or be deleted as).
     */
    private static function is_reserved_sync_path($path) {
        return in_array($path, ['database.sql', 'database.sql.part', 'disembark-source.json'], true)
            || strpos($path, '.disembark-db-parts/') === 0
            || strpos($path, '.disembark-manifests/') === 0;
    }

    /**
     * Drops source files that can't be written safely under $folder (unsafe
     * names, a local symlink on the way) and, for a sync mirror, ones named
     * like sync's own files. Says what it left out; they count as failures.
     */
    private static function filter_writable_files($remote_files_map, $folder, $is_mirror) {
        $skipped = [];
        foreach ($remote_files_map as $name => $file) {
            $reason = null;
            if ($is_mirror && self::is_reserved_sync_path($name)) {
                $reason = 'named like one of sync\'s own files';
            } elseif (!self::local_path_safe($folder, $name)) {
                $reason = 'unsafe path or a symlink in the local folder';
            }
            if ($reason !== null) {
                $skipped[] = "$name ($reason)";
                unset($remote_files_map[$name]);
            }
        }
        if (!empty($skipped)) {
            echo " - Left out " . count($skipped) . " file(s) that can't be written safely here:\n";
            foreach (array_slice($skipped, 0, 10) as $line) {
                echo "   - $line\n";
            }
            if (count($skipped) > 10) {
                echo "   - ...and " . (count($skipped) - 10) . " more\n";
            }
            self::$failures = array_merge(self::$failures, $skipped);
        }
        return $remote_files_map;
    }

    /**
     * The background extractor: a small PHP script (written once to the temp
     * folder) that unpacks a downloaded chunk into the folder entry by entry.
     * Unlike ZipArchive::extractTo it refuses any entry whose path leaves the
     * folder or passes through a symlink, and replaces files rather than
     * writing through an existing link. Refused entries are listed in
     * <zip>.skipped for the caller to report.
     */
    private static function extractor_script() {
        static $path = null;
        if ($path !== null && file_exists($path)) {
            return $path;
        }
        $code = <<<'PHP'
<?php
// Disembark CLI: unpack a chunk zip into a folder without leaving it.
list(, $zip_path, $dest) = $argv;
$root = realpath($dest);
$zip = new ZipArchive();
if ($root === false || $zip->open($zip_path) !== true) {
    file_put_contents($zip_path . '.skipped', "(could not open the chunk zip)\n", FILE_APPEND);
    @unlink($zip_path);
    exit(1);
}
$safe = function ($rel) use ($root) {
    if ($rel === '' || strpos($rel, "\0") !== false || strpos($rel, '\\') !== false || $rel[0] === '/' || preg_match('#^[A-Za-z]:#', $rel)) return false;
    $parts = explode('/', $rel);
    $path = $root;
    foreach ($parts as $i => $seg) {
        if ($seg === '' || $seg === '.' || $seg === '..') return false;
        $path .= '/' . $seg;
        if (is_link($path)) return false;
        if (!file_exists($path)) return true;
        if ($i < count($parts) - 1 && !is_dir($path)) return false;
    }
    return !is_dir($path);
};
for ($i = 0; $i < $zip->numFiles; $i++) {
    $name = $zip->getNameIndex($i);
    if ($name === false || substr($name, -1) === '/') continue;
    if (!$safe($name)) {
        file_put_contents($zip_path . '.skipped', $name . "\n", FILE_APPEND);
        continue;
    }
    $target = $root . '/' . $name;
    $dir = dirname($target);
    if (!is_dir($dir) && !@mkdir($dir, 0755, true) && !is_dir($dir)) {
        file_put_contents($zip_path . '.skipped', $name . "\n", FILE_APPEND);
        continue;
    }
    // Checked again now the folders exist, then written to a new file
    // (x: never an existing path or link) and moved into place.
    $tmp = $target . '.disembark-' . bin2hex(random_bytes(4));
    $in = $safe($name) ? $zip->getStream($name) : false;
    $out = $in ? @fopen($tmp, 'xb') : false;
    if (!$in || !$out) {
        if ($in) fclose($in);
        file_put_contents($zip_path . '.skipped', $name . "\n", FILE_APPEND);
        continue;
    }
    $ok = stream_copy_to_stream($in, $out) !== false;
    fclose($in);
    fclose($out);
    if (!$ok || !rename($tmp, $target)) {
        @unlink($tmp);
        file_put_contents($zip_path . '.skipped', $name . "\n", FILE_APPEND);
    }
}
$zip->close();
unlink($zip_path);
PHP;
        $path = rtrim(sys_get_temp_dir(), DIRECTORY_SEPARATOR) . '/disembark-extract-' . self::VERSION . '-' . getmypid() . '.php';
        file_put_contents($path, $code);
        return $path;
    }

    /**
     * Waits for background extractions in $folder to finish and reports any
     * entries they refused or couldn't write as failures.
     */
    private static function wait_for_extractions($folder, $max_seconds) {
        $mine = [];
        foreach (self::$pending_extractions as $i => $zip) {
            if (strpos($zip, rtrim($folder, '/') . '/') === 0) {
                $mine[] = $zip;
                unset(self::$pending_extractions[$i]);
            }
        }
        $still = function () use ($mine) {
            clearstatcache();
            return array_values(array_filter($mine, 'file_exists'));
        };
        $wait_ticks = 0;
        while (count($still()) > 0) {
            if ($wait_ticks === 0) echo "Waiting for background extraction to finish...";
            echo ".";
            sleep(1);
            $wait_ticks++;
            if ($wait_ticks > $max_seconds) {
                echo "\nWarning: Background extraction taking too long. Some zip files may remain in $folder.\n";
                self::$failures[] = "(chunk zips still unpacking in $folder)";
                break;
            }
        }
        if ($wait_ticks > 0) echo " Done.\n";
        foreach ($mine as $zip) {
            $list = $zip . '.skipped';
            if (!is_file($list) || is_link($list)) {
                continue;
            }
            foreach (file($list, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $name) {
                self::$failures[] = "$name (not unpacked)";
            }
            @unlink($list);
        }
    }

    /**
     * After the chunk zips are unpacked: every file asked for should now be
     * in $folder. The source leaves a file out of its zip when it can't read
     * it (permissions, or deleted since the list was made); each one missing
     * is a failure, so a backup or sync that lacks it never reports success.
     */
    private static function verify_arrived($files, $folder) {
        $known = [];
        foreach (self::$failures as $line) {
            $known[preg_replace('/ \([^()]*\)$/', '', $line)] = true;
        }
        $missing = 0;
        foreach ($files as $f) {
            $name = isset($f->name) ? (string) $f->name : '';
            if ($name === '' || isset($known[$name])) {
                continue;
            }
            clearstatcache(true, $folder . '/' . $name);
            if (!is_file($folder . '/' . $name)) {
                self::$failures[] = "$name (the source didn't send it: unreadable there, or deleted since the list was made)";
                $missing++;
            }
        }
        if ($missing > 0) {
            echo " - $missing file(s) the source listed did not arrive.\n";
        }
    }

    /**
     * Prints the files that couldn't be copied. Returns true when there were
     * any (the caller then exits non-zero).
     */
    private static function report_failures() {
        if (empty(self::$failures)) {
            return false;
        }
        $failures = array_values(array_unique(self::$failures));
        echo "\n" . count($failures) . " file(s) could not be copied:\n";
        foreach (array_slice($failures, 0, 20) as $line) {
            echo " - $line\n";
        }
        if (count($failures) > 20) {
            echo " - ...and " . (count($failures) - 20) . " more\n";
        }
        return true;
    }
    /**
     * Downloads a file from the /stream-file endpoint using WpOrg\Requests.
     */
    private static function download_file_via_stream($relative_path, $destination) {
        $attempts = 0;
        $max_attempts = 3;
        $last_error = "";
        $wait = 2;

        while ($attempts < $max_attempts) {
            $attempts++;
            try {
                // Use self::$siteUrl and self::$token
                $endpoint_url = self::rest_url('/stream-file');
                $payload = json_encode(['token' => self::$token, 'file' => $relative_path] + self::site_param());
                $headers = ['Content-Type' => 'application/json'] + self::api_headers();
                $options = [
                    'verify' => false,
                    'timeout' => 1800,
                    'connect_timeout' => 30,
                    'useragent' => self::$user_agent
                 ];
                $response = \WpOrg\Requests\Requests::post($endpoint_url, $headers, $payload, $options);

                if (!$response->success) {
                    if ($response->status_code == 429 || $response->status_code == 503) {
                        $wait = self::retry_wait($response, $attempts);
                    }
                    if ($response->status_code == 404 || $response->status_code == 403) {
                        throw new \Exception("Stream API failed: HTTP {$response->status_code}. Body: " . substr($response->body, 0, 200));
                    }
                    throw new \Exception("Stream API request failed with status code: {$response->status_code}. Body: " . substr($response->body, 0, 200));
                }

                // Beside the destination first, so a failed write never
                // leaves half a file under its name.
                $part = $destination . '.part';
                if (is_link($part)) @unlink($part);
                if (file_put_contents($part, $response->body) !== strlen($response->body) || !rename($part, $destination)) {
                    @unlink($part);
                    throw new \Exception("Failed to write downloaded stream content to $destination.");
                }
                return;

            } catch (\Exception $e) {
                echo "\nWarning: Failed to stream $relative_path (Attempt $attempts/$max_attempts): {$e->getMessage()}\n";
                $last_error = $e->getMessage();
                if ($attempts < $max_attempts) {
                    echo "Retrying in {$wait} seconds...\n";
                    sleep($wait);
                    $wait = 2;
                }
            }
        }
        throw new \Exception("Stream failed after $max_attempts attempts. Last error: $last_error");
    }

    /**
     * Downloads a database export file, trying direct download first and falling back to stream.
     */
    private static function download_db_file($relative_path, $destination) {
        // One site of a network or WP Freighter install keeps its exports in
        // the install's folder, at the install's address (a subdirectory
        // subsite's own address doesn't serve the main site's uploads).
        $base = self::$siteUrl;
        $caps = self::scoped_source() ? self::source_caps() : null;
        if (is_object($caps) && !empty($caps->scope->install_home)) {
            $base = rtrim((string) $caps->scope->install_home, '/');
        }
        // Strip site URL path prefix for subdirectory installs to avoid doubled paths
        // e.g. "subdir/wp-content/uploads/..." -> "wp-content/uploads/..."
        $site_parsed = parse_url(self::$siteUrl);
        $site_path_prefix = isset($site_parsed['path']) ? ltrim($site_parsed['path'], '/') : '';
        if (!empty($site_path_prefix) && strpos($relative_path, $site_path_prefix . '/') === 0) {
            $relative_path = substr($relative_path, strlen($site_path_prefix) + 1);
        }

        $path_parts = explode('/', $relative_path);
        $encoded_parts = array_map('rawurlencode', $path_parts);
        $encoded_relative_path = implode('/', $encoded_parts);
        $direct_url = $base . '/' . $encoded_relative_path;

        try {
            self::download_file_direct($direct_url, $destination);
            return;
        } catch (\Exception $e) {
            echo "\nWarning: Direct download failed for '$relative_path': {$e->getMessage()}\n";
            echo "Attempting to download via stream API as fallback...\n";
        }

        try {
            self::download_file_via_stream($relative_path, $destination);
            echo "Stream API download successful for: $relative_path\n";
        } catch (\Exception $e) {
            echo "\nStream API fallback also failed: {$e->getMessage()}\n";
            throw new \Exception("Failed to download '$relative_path' using both direct and stream methods.");
        }
    }

    /**
     * Generates a local manifest of files.
     */
    private static function generate_local_manifest($dir, $skip_checksums = false) {
        $files_map = [];
        $real_root = realpath($dir);
        if ($real_root === false) return [];

        $iterator = new \RecursiveIteratorIterator(
            new \RecursiveDirectoryIterator($real_root, \RecursiveDirectoryIterator::SKIP_DOTS),
            \RecursiveIteratorIterator::SELF_FIRST
        );
        foreach ($iterator as $file) {
            // Symlinks are never followed or read: a link may point outside
            // the mirror. (The iterator doesn't descend into linked folders.)
            if ($file->isLink() || $file->isDir()) continue;
            $path = $file->getPathname();
            $relative_path = str_replace(DIRECTORY_SEPARATOR, '/', ltrim(substr($path, strlen($real_root)), DIRECTORY_SEPARATOR));

            // Skip sync-specific files
            if ($relative_path === 'db_export.sql' || self::is_reserved_sync_path($relative_path)) {
                continue;
            }

            // Skip expensive MD5 calc if requested
            $checksum = ($skip_checksums) ? null : md5_file($path);

            $files_map[$relative_path] = (object) [
                'name' => $relative_path,
                'size' => $file->getSize(),
                'checksum' => $checksum
            ];
        }
        return $files_map;
    }

    /**
     * Removes the folders a sync emptied by deleting $rel: its parent, then
     * theirs, up to (never including) $root. Stops at the first folder that
     * still holds something, or that is a symlink.
     */
    private static function remove_emptied_parents($root, $rel) {
        $real_root = realpath($root);
        $dir = dirname($rel);
        while ($real_root !== false && $dir !== '.' && $dir !== '' && $dir !== '/') {
            $path = $real_root . DIRECTORY_SEPARATOR . $dir;
            if (is_link($path) || !is_dir($path) || (new \FilesystemIterator($path))->valid()) {
                return;
            }
            if (!@rmdir($path)) {
                return;
            }
            $dir = dirname($dir);
        }
    }

    /**
     * Unzips a file to a destination.
     */
    private static function unzip_file($file, $destination) {
        if (!class_exists('ZipArchive')) {
            throw new \Exception('ZipArchive PHP extension is required to unpack files.');
        }
        
        $zip = new \ZipArchive;
        $res = $zip->open($file);
        
        if ($res === TRUE) {
            if ($zip->extractTo($destination) === FALSE) {
                $zip->close();
                throw new \Exception("Failed to extract $file to $destination.");
            }
            $zip->close();
        } else {
            // $res contains the error code (e.g. ZipArchive::ER_NOZIP)
            throw new \Exception("Failed to open zip archive $file. Error code: $res");
        }
    }

    /**
     * Zips a directory into a single archive.
     */
    private static function zip_directory($source, $destination) {
        if (!class_exists('ZipArchive')) {
            throw new \Exception('ZipArchive PHP extension is required to create the final zip.');
        }
        $real = realpath($source);
        if ($real === false) {
            throw new \Exception("Source directory $source does not exist.");
        }
        $source = $real;
        $zip = new \ZipArchive();
        // open() returns true or an error code (a truthy int), and PHP 8
        // throws a ValueError for some bad paths: only true is success.
        try {
            $opened = $zip->open($destination, \ZipArchive::CREATE | \ZipArchive::OVERWRITE);
        } catch (\Throwable $e) {
            throw new \Exception("Failed to create zip archive at $destination: " . $e->getMessage());
        }
        if ($opened !== true) {
            throw new \Exception("Failed to create zip archive at $destination (ZipArchive error $opened).");
        }

        $files = new \RecursiveIteratorIterator(
            new \RecursiveDirectoryIterator($source, \RecursiveDirectoryIterator::SKIP_DOTS),
            \RecursiveIteratorIterator::SELF_FIRST
        );
        // Add the root 'public' directory itself
        $zip->addEmptyDir('public');
        foreach ($files as $file) {
            $file = realpath($file);
            // Get relative path for root of zip
            $relativePath = 'public' . DIRECTORY_SEPARATOR . substr($file, strlen($source) + 1);

            if (empty($relativePath)) continue; // Skip the root folder itself

            if (is_dir($file)) {
                $zip->addEmptyDir($relativePath);
            } else if (is_file($file)) {
                if (!$zip->addFile($file, $relativePath)) {
                    throw new \Exception("Could not add $relativePath to the zip.");
                }
            }
        }
        // ZipArchive writes everything at close(): a full disk shows up
        // here, not before. A zip that didn't close isn't a backup.
        $closed = false;
        $why    = 'is the disk full?';
        try {
            $closed = $zip->close();
        } catch (\Throwable $e) {
            $why = $e->getMessage();
        }
        clearstatcache(true, $destination);
        if (!$closed || !is_file($destination) || filesize($destination) === 0) {
            @unlink($destination);
            throw new \Exception("Could not write the zip $destination ($why).");
        }
    }

    /**
     * Recursively deletes a directory.
     */
    private static function delete_directory($dir) {
        if (is_link($dir)) {
            unlink($dir); // the link only, never the folder it points to
            return;
        }
        if (!is_dir($dir)) {
            return;
        }
        $it = new \RecursiveDirectoryIterator($dir, \RecursiveDirectoryIterator::SKIP_DOTS);
        $files = new \RecursiveIteratorIterator($it, \RecursiveIteratorIterator::CHILD_FIRST);
        foreach ($files as $file) {
            // A link is removed itself, never what it points to.
            if ($file->isDir() && !$file->isLink()) {
                rmdir($file->getPathname());
            } else {
                unlink($file->getPathname());
            }
        }
        rmdir($dir);
    }
    // liveExecuteCommand is (no longer used by backup)
    private static function liveExecuteCommand($cmd) {
        while (@ ob_end_flush());
        $proc = popen("$cmd 2>&1", 'r');
        if ($proc === false) {
            echo "Error: Failed to execute command: $cmd\n";
            return;
        }
        $live_output = "";
        $complete_output = "";
        while (!feof($proc)) {
            $live_output = fread($proc, 4096);
            if ($live_output === false) {
                break;
            }
            $complete_output = $complete_output . $live_output;
            echo "$live_output";
            @ flush();
        }

        pclose($proc);
    }
