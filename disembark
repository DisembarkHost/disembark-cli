#!/usr/bin/env php
<?php
namespace Disembark;

class Run {

    const VERSION = '3.0.0';
    const USER_AGENT = 'Disembark/' . self::VERSION;

    private static $siteUrl;
    private static $token;
    private static $backup_token;
    // Application-password credentials (preferred auth). When set, requests
    // send HTTP Basic Auth and the server authorizes via current_user_can.
    private static $username;
    private static $password;
    // REST routing style for the site: 'pretty' (/wp-json/...) or 'rest_route'
    // (/?rest_route=/...), the latter for sites with plain permalinks where the
    // pretty path has no rewrite rule.
    private static $rest_style = 'pretty';
    /** --site=<id>: one site of a multisite network or WP Freighter install (backup, sync). */
    private static $site = '';
    // The last API error make_request() saw: HTTP status, the WP_Error code
    // and message when the body was one. Lets a caller tell "this source
    // has no such route" (an older plugin) from a real refusal.
    private static $last_error = null;
    
    // Default Thresholds
    private static $db_max_size = 209715200;       // 200MB
    private static $db_max_rows = 1000000;         // 1M rows
    private static $upload_chunk_bytes = 20971520; // 20MB restore upload chunks
    private static $upload_limit_known = false;
    private static $file_chunk_size = 2500;        // 2500 files
    private static $file_chunk_max_size = 524288000; // 500MB
    private static $large_file_threshold = 10485760; // 10MB
    
    // Options
    private static $session_id = null;
    private static $exclude_paths = [];
    private static $exclude_tables = [];
    private static $preview = false;
    private static $debug = false;
    private static $skip_db = false;
    private static $skip_files = false;
    private static $skip_checksums = false;
    private static $cleanup = false;
    private static $user_agent = self::USER_AGENT;
    private static $cookie = null;

    // Restore options
    private static $source_url = null;
    private static $source_prefix = null;
    private static $rollback_id = null;
    private static $assume_yes = false;

    // What the source announced in its preflight (null until asked, false
    // when it didn't answer): v3 sources say `pacing`, `resumable` and
    // `fingerprint`, and take the token in the X-Disembark-Token header.
    private static $source_caps = null;

    // Files a backup or sync could not copy, reported at the end (and the
    // exit status is non-zero when there are any).
    private static $failures = [];
    // Chunk zips handed to the background extractor, waited on by path
    // (never by a name pattern a site's own file could match).
    private static $pending_extractions = [];

    // Where sync keeps its record of the source's files (relative to the
    // mirror). Restore never deploys .disembark-manifests/.
    const SYNC_STATE = '.disembark-manifests/sync-state.json';

    // Global Progress Tracking
    private static $global_bytes_total = 0;
    private static $global_bytes_processed = 0;

    /**
     * Parses CLI arguments to populate static class properties.
     * Handles flags, values, and the optional sync folder argument.
     * @return string|null The folder path if found (for sync), otherwise null.
     */
    private static function parseArguments($argv, $startIndex = 3) {
        $folder = null;
        $argc = count($argv);

        for ($i = $startIndex; $i < $argc; $i++) {
            $arg = $argv[$i];

            // --- 1. Boolean Flags ---
            if ($arg === '--preview') {
                self::$preview = true;
                continue;
            }
            if ($arg === '--debug') {
                self::$debug = true;
                continue;
            }
            if ($arg === '--skip-db') {
                self::$skip_db = true;
                continue;
            }
            if ($arg === '--skip-files') {
                self::$skip_files = true;
                continue;
            }
            if ($arg === '--skip-checksums') {
                self::$skip_checksums = true;
                continue;
            }
            if ($arg === '--cleanup') {
                self::$cleanup = true;
                continue;
            }
            if ($arg === '--yes' || $arg === '-y') {
                self::$assume_yes = true;
                continue;
            }
            if (strpos($arg, '--source-url=') === 0) {
                self::$source_url = rtrim(substr($arg, strlen('--source-url=')), '/');
                continue;
            }
            if (strpos($arg, '--source-prefix=') === 0) {
                self::$source_prefix = substr($arg, strlen('--source-prefix='));
                continue;
            }
            if (strpos($arg, '--rollback=') === 0) {
                self::$rollback_id = substr($arg, strlen('--rollback='));
                continue;
            }

            // --- 2. Value Flags ---
            if (strpos($arg, '--token=') === 0) {
                self::$token = substr($arg, strlen('--token='));
                continue;
            }
            if (strpos($arg, '--session-id=') === 0) {
                self::$session_id = substr($arg, strlen('--session-id='));
                continue;
            }
            if (strpos($arg, '--db-max-size=') === 0) {
                self::$db_max_size = self::convert_to_bytes(substr($arg, strlen('--db-max-size=')));
                continue;
            }
            if (strpos($arg, '--db-max-rows=') === 0) {
                self::$db_max_rows = (int)substr($arg, strlen('--db-max-rows='));
                continue;
            }
            if (strpos($arg, '--file-chunk-size=') === 0) {
                self::$file_chunk_size = (int)substr($arg, strlen('--file-chunk-size='));
                continue;
            }
            if (strpos($arg, '--file-chunk-max-size=') === 0) {
                self::$file_chunk_max_size = self::convert_to_bytes(substr($arg, strlen('--file-chunk-max-size=')));
                continue;
            }
            if (strpos($arg, '--large-file-threshold=') === 0) {
                self::$large_file_threshold = self::convert_to_bytes(substr($arg, strlen('--large-file-threshold=')));
                continue;
            }
            if (strpos($arg, '--site=') === 0) {
                self::$site = trim(substr($arg, strlen('--site=')));
                continue;
            }
            if (strpos($arg, '--user-agent=') === 0) {
                self::$user_agent = substr($arg, strlen('--user-agent='));
                continue;
            }
            if (strpos($arg, '--cookie=') === 0) {
                self::$cookie = substr($arg, strlen('--cookie='));
                continue;
            }
            
            // --- 3. Exclusions ---
            if ($arg === '-x') {
                // Check if next arg exists and is not another flag
                if (isset($argv[$i + 1]) && strpos($argv[$i + 1], '-') !== 0) {
                    // Paths are relative to the site root: "./wp-content/x/"
                    // and "/wp-content/x" both mean "wp-content/x".
                    $exclude = trim(preg_replace('#^(\./)+#', '', $argv[$i + 1]), '/');
                    if ($exclude !== '') {
                        self::$exclude_paths[] = $exclude;
                    }
                    $i++; // Skip the next argument as we consumed it
                } else {
                    echo "Error: Missing value for -x option.\n";
                    exit(1);
                }
                continue;
            }
            if (strpos($arg, '--exclude-tables=') === 0) {
                $val = substr($arg, strlen('--exclude-tables='));
                self::$exclude_tables = explode(',', $val);
                continue;
            }

            // --- 4. Positional Argument (Sync Folder) ---
            // If it's not a flag (start with -) and we haven't found a folder yet
            if (strpos($arg, '-') !== 0 && $folder === null) {
                $folder = $arg;
            } elseif (strpos($arg, '-') !== 0) {
                // Determine if this is an unknown argument or extra positional
                echo "Warning: Ignoring unknown argument '$arg'.\n";
            }
        }

        return $folder;
    }

    public static function main($argv, $argc) {
        if ($argc < 2) {
            self::showHelp();
            exit(0);
        }

        $command = $argv[1];

        // 1. Handle "Standalone" Commands
        // These do not require a site URL or configuration file to run.
        switch ($command) {
            case 'version':
                self::version();
                exit(0);
            case 'upgrade':
                self::upgrade();
                exit(0);
            case 'list':
                self::sites();
                exit(0);
            case 'connect':
                if ($argc != 4) {
                    echo "Error: Invalid arguments for connect\n";
                    exit(1);
                }
                self::connect($argv[2], $argv[3]);
                exit(0);
            case 'remove':
                if ($argc < 3) {
                    echo "Error: Missing <site-url> argument.\n";
                    exit(1);
                }
                self::remove($argv[2]);
                exit(0);
        }

        // 2. Bootstrapping for "Site" Commands (backup, sync, ncdu)
        // These commands require a <site-url> as the second argument.
        if ($argc < 3) {
            echo "Error: Missing <site-url> argument.\n";
            self::showHelp();
            exit(1);
        }

        // A. Set Global Site URL
        self::$siteUrl = $argv[2]; 

        // B. Load Config from disk
        // This attempts to find the token for self::$siteUrl in .disembark
        self::load_config(self::$siteUrl);

        // C. Parse Flags
        $sync_folder = self::parseArguments($argv, 3);

        // Ask the source what it supports first: a v3 source takes the token
        // in a header (kept out of URLs) and cleans up over POST.
        if (in_array($command, ['backup', 'sync', 'ncdu', 'info'], true)) {
            self::source_caps();
        }

        // --session-id reuses the file lists a scan already made, for the
        // site that scan was made for: the database, zips and streams must
        // be scoped the same way, or one backup mixes two sites.
        if (self::$session_id && in_array($command, ['backup', 'sync'], true)) {
            self::match_session_site();
        }

        // 3. Dispatch Command
        switch ($command) {
            case 'backup':
                self::backup();
                break;

            case 'sync':
                // Logic to determine destination folder
                if ($sync_folder === null) {
                    // Default to domain name, plus the site for --site, so
                    // two sites of one install never share a folder.
                    $sync_folder = preg_replace('/^https?:\/\/(www\.)?/', '', rtrim(self::$siteUrl, '/'));
                    if (self::site_key() !== '') {
                        $sync_folder .= '-site-' . self::site_key();
                    }
                }

                // Resolve to absolute path
                if (substr($sync_folder, 0, 1) !== DIRECTORY_SEPARATOR && !(strlen($sync_folder) > 1 && substr($sync_folder, 1, 1) === ':')) {
                    $sync_folder = getcwd() . DIRECTORY_SEPARATOR . $sync_folder;
                }
                
                self::sync($sync_folder);
                break;

            case 'ncdu':
                self::ncdu();
                break;

            case 'restore':
                // Roll back a prior import instead of restoring, when asked.
                if (self::$rollback_id !== null) {
                    self::restore_rollback(self::$rollback_id);
                    break;
                }
                if ($sync_folder === null) {
                    echo "Error: restore requires a <folder> (a snapshot produced by 'disembark backup').\n";
                    exit(1);
                }
                // Resolve the folder to an absolute path (same rule as sync).
                if (substr($sync_folder, 0, 1) !== DIRECTORY_SEPARATOR && !(strlen($sync_folder) > 1 && substr($sync_folder, 1, 1) === ':')) {
                    $sync_folder = getcwd() . DIRECTORY_SEPARATOR . $sync_folder;
                }
                self::restore($sync_folder);
                break;

            case 'info':
                self::info();
                break;

            default:
                echo "Error: Unknown command '$command'.\n";
                self::showHelp();
                exit(1);
        }
    }

    private static function connect($siteUrl, $token) {
        // Trim trailing slashes from the site URL
        $siteUrl = rtrim($siteUrl, '/');
        // Verify the site URL starts with http:// or https://
        if (!preg_match('/^https?:\/\//', $siteUrl)) {
            $siteUrl = "https://$siteUrl";
            echo "The site URL must start with http:// or https://. Attempting to use $siteUrl\n";
        }

        $homeDir = getenv('HOME');
        if (!$homeDir) {
            echo "Error: Unable to determine the home directory.\n";
            exit(1);
        }

        if (empty($siteUrl) || empty($token)) {
            echo "Error: Required arguments <site-url> and <token-or-credential>.\n";
            exit(1);
        }

        // A credential containing a colon is treated as an application password
        // in "username:application password" form (the preferred, capability-
        // gated auth). Anything else is the legacy per-site token.
        $username    = null;
        $app_password = null;
        if (strpos($token, ':') !== false) {
            list($username, $app_password) = explode(':', $token, 2);
            // WordPress ignores the display spaces in application passwords.
            $app_password = str_replace(' ', '', $app_password);
        }

        // Probe the pretty route first, then the plain-permalink form. Whichever
        // returns the table list is stored so later commands use it directly.
        $rest_style = null;
        $last_status = null;
        // A token goes in the X-Disembark-Token header first (v3 reads it
        // there, keeping it out of URLs and logs), then in the query for
        // 2.9 sources, which only read it there.
        $attempts = [];
        foreach (['pretty', 'rest_route'] as $style) {
            $attempts[] = [$style, false];
            if ($username === null) {
                $attempts[] = [$style, true];
            }
        }
        foreach ($attempts as list($style, $token_in_query)) {
            $probe_url = ($style === 'rest_route')
                ? "$siteUrl/?rest_route=/disembark/v1/database"
                : "$siteUrl/wp-json/disembark/v1/database";
            $headers = [];
            if ($username !== null) {
                $headers['Authorization'] = 'Basic ' . base64_encode("$username:$app_password");
            } elseif ($token_in_query) {
                $sep = (strpos($probe_url, '?') !== false) ? '&' : '?';
                $probe_url .= $sep . 'token=' . urlencode($token);
            } else {
                $headers['X-Disembark-Token'] = $token;
            }
            try {
                $response = \WpOrg\Requests\Requests::get($probe_url, $headers, ['verify' => false, 'timeout' => 60, 'useragent' => self::USER_AGENT]);
            } catch (\WpOrg\Requests\Exception $e) {
                echo "Error: Request failed with error: {$e->getMessage()}\n";
                exit(1);
            }
            $last_status = $response->status_code;
            if ($response->status_code === 200) {
                $tables = json_decode($response->body);
                if (!empty($tables) && is_array($tables)) {
                    $rest_style = $style;
                    break;
                }
            }
        }

        if ($rest_style === null) {
            echo "Error: Failed to connect to $siteUrl (last status: $last_status). Check your URL, credentials, and that the Disembark plugin is active.\n";
            exit(1);
        }

        $filePath = $homeDir . '/.disembark';
        $data = [];
        // Check if the file already exists and read its contents
        if (file_exists($filePath)) {
            $jsonContents = file_get_contents($filePath);
            $data = json_decode($jsonContents);
            // Ensure $data is always an array for consistent processing
            if (!is_array($data)) {
                // Try decoding as an object first for legacy compatibility
                if (is_object($data)) {
                    // Convert object to array of objects
                    $data = [$data];
                } else {
                    $data = []; // Initialize as empty array if decoding failed or was invalid
                }
            }
        }

        // Build the entry for this site: either app-password credentials or a
        // legacy token.
        if ($username !== null) {
            $entry_data = (object) [
                'siteUrl'    => $siteUrl,
                'username'   => $username,
                'password'   => $app_password,
                'rest_style' => $rest_style,
            ];
        } else {
            $entry_data = (object) [
                'siteUrl'    => $siteUrl,
                'token'      => $token,
                'rest_style' => $rest_style,
            ];
        }

        // Check if the siteUrl already exists and replace it, otherwise add new
        $found = false;
        foreach ($data as $key => $entry) {
            // Ensure entry is an object before accessing properties
            if (is_object($entry) && !empty($entry->siteUrl) && $entry->siteUrl === $siteUrl) {
                $data[$key] = $entry_data; // Replace so stale auth fields don't linger
                $found = true;
                break;
            }
        }

        if (!$found) {
            $data[] = $entry_data;
        }

        $jsonData = json_encode($data, JSON_PRETTY_PRINT);
        if (file_put_contents($filePath, $jsonData) === false) {
            echo "Error: Unable to write to $filePath.\n";
            exit(1);
        }
        @chmod($filePath, 0600); // holds tokens / app passwords in plain text

        $auth_kind = $username !== null ? "application password for user '$username'" : "token";
        echo "Successfully connected to $siteUrl using $auth_kind. Saved credentials to $filePath\n";
    }

    /**
     * Persists (or updates) the stored token for a connected site, keeping any
     * app-password fields. Used by restore to pin the destination's preserved
     * token so a later --rollback still authenticates: the database import
     * wipes application passwords, leaving the preserved site token as the
     * only credential that survives a restore.
     */
    private static function save_site_token($siteUrl, $token) {
        $homeDir = getenv('HOME');
        if (!$homeDir || empty($token)) {
            return;
        }
        $filePath = $homeDir . '/.disembark';
        $data = [];
        if (file_exists($filePath)) {
            $data = json_decode(file_get_contents($filePath));
            if (!is_array($data)) {
                $data = is_object($data) ? [$data] : [];
            }
        }
        $found = false;
        foreach ($data as $entry) {
            if (is_object($entry) && isset($entry->siteUrl) && $entry->siteUrl === $siteUrl) {
                $entry->token = $token;
                $found = true;
                break;
            }
        }
        if (!$found) {
            $data[] = (object) ['siteUrl' => $siteUrl, 'token' => $token, 'rest_style' => self::$rest_style];
        }
        if (file_put_contents($filePath, json_encode($data, JSON_PRETTY_PRINT)) !== false) {
            @chmod($filePath, 0600);
        }
    }

    private static function remove($siteUrl) {
        // Normalize the URL to ensure it matches how it's stored
        $siteUrl = rtrim($siteUrl, '/');
        if (!preg_match('/^https?:\/\//', $siteUrl)) {
            $siteUrl = "https://$siteUrl";
        }

        $homeDir = getenv('HOME');
        if (!$homeDir) {
            echo "Error: Unable to determine the home directory.\n";
            exit(1);
        }

        $filePath = $homeDir . '/.disembark';
        
        if (!file_exists($filePath)) {
            echo "Error: No configuration file found at $filePath.\n";
            exit(1);
        }

        $jsonContents = file_get_contents($filePath);
        $data = json_decode($jsonContents);
        
        // Handle legacy single-object format or invalid data
        if (!is_array($data)) {
            $data = is_object($data) ? [$data] : [];
        }

        $originalCount = count($data);
        $newData = [];
        $found = false;

        foreach ($data as $entry) {
            if (is_object($entry) && isset($entry->siteUrl) && $entry->siteUrl === $siteUrl) {
                $found = true;
                continue; // Skip this entry to remove it
            }
            $newData[] = $entry;
        }

        if ($found) {
            $jsonData = json_encode($newData, JSON_PRETTY_PRINT);
            if (file_put_contents($filePath, $jsonData) === false) {
                echo "Error: Unable to write to $filePath.\n";
                exit(1);
            }
            echo "Successfully removed credentials for $siteUrl\n";
        } else {
            echo "No credentials found for $siteUrl\n";
        }
    }

    /**
     * Builds a REST URL for an endpoint honoring the site's routing style.
     * $endpoint is like '/database' or '/import/sql'.
     */
    private static function rest_url($endpoint) {
        if (self::$rest_style === 'rest_route') {
            return self::$siteUrl . '/?rest_route=/disembark/v1' . $endpoint;
        }
        return self::$siteUrl . '/wp-json/disembark/v1' . $endpoint;
    }

    /**
     * Returns the HTTP Basic Auth header value when application-password
     * credentials are configured, otherwise null.
     */
    private static function auth_header() {
        if (!empty(self::$username) && !empty(self::$password)) {
            return 'Basic ' . base64_encode(self::$username . ':' . self::$password);
        }
        return null;
    }

    /**
     * A new session or import id: 128 random bits as 32 hex characters, the
     * form v3 mints itself. The id names a folder of dumps and zips under the
     * source's uploads, so it has to be unguessable. 2.9 takes any hex.
     */
    private static function new_session_id() {
        return bin2hex(random_bytes(16));
    }

    /**
     * Auth headers for Disembark's API: the application password (Basic
     * Auth) and the token in X-Disembark-Token, which v3 reads so the token
     * can stay out of URLs. 2.9 ignores the header and reads the token from
     * the body or query, which make_request() still sends. Never sent to
     * public file URLs.
     */
    private static function api_headers() {
        $headers = [];
        $auth = self::auth_header();
        if ($auth) {
            $headers['Authorization'] = $auth;
        }
        if (!empty(self::$token)) {
            $headers['X-Disembark-Token'] = self::$token;
        }
        if (self::$cookie) {
            $headers['Cookie'] = self::$cookie;
        }
        return $headers;
    }

    /** api_headers() as "Name: value" lines, for raw cURL handles. */
    private static function api_header_lines($extra = []) {
        $lines = [];
        foreach (array_merge(self::api_headers(), $extra) as $name => $value) {
            $lines[] = "$name: $value";
        }
        return $lines;
    }

    /**
     * Asks the source's preflight once and keeps the answer: its address and
     * table prefix (for disembark-source.json) and what it supports (`pacing`,
     * `resumable` and `fingerprint` on v3). False when it didn't answer
     * (a pre-2.8 source).
     */
    private static function source_caps() {
        if (self::$source_caps !== null) {
            return self::$source_caps;
        }
        self::$source_caps = false; // also stops make_request() asking again meanwhile
        self::$last_error = null;
        try {
            $pre = self::make_request('/import/preflight', ['import_id' => self::new_session_id()] + (self::$site !== '' ? ['site' => self::$site] : []), 'POST', true);
            if (is_object($pre)) {
                unset($pre->disembark_token);
                self::$source_caps = $pre;
            }
        } catch (\Exception $e) {
            // The plugin itself turned the request away (an unknown --site,
            // a site that isn't a network): say why and stop, rather than
            // carry on as if the source were an older plugin. WordPress's
            // own rest_* answers (no such route on a pre-2.8 source) still
            // fall back to the 2.9 behavior.
            $err = self::$last_error;
            if ($err && $err['code'] !== '' && strpos($err['code'], 'rest_') !== 0 && $err['status'] >= 400 && $err['status'] < 500) {
                echo "Error: " . ($err['message'] !== '' ? $err['message'] : "the source refused the request ({$err['code']}).") . "\n";
                exit(1);
            }
            // Older source; carry on with the 2.9 behavior.
        }
        // --site needs a source that knows about networks and tenants (3.0):
        // an older one ignores it and would hand over the whole install.
        if (self::$site !== '' && !(is_object(self::$source_caps) && property_exists(self::$source_caps, 'install'))) {
            echo "Error: --site needs Disembark 3.0 or newer on the source; this one would send the whole install. Update Disembark there, or leave out --site.\n";
            exit(1);
        }
        return self::$source_caps;
    }

    /**
     * What the source recorded about the --session-id scan (from the
     * sessions /backup-size lists): ['site' => '<id>' or '' for the whole
     * install, 'filtered' => bool], with 'site' left out when the source
     * didn't record it (older Disembark). null when the session isn't listed.
     */
    private static function session_meta() {
        static $meta = false;
        if ($meta !== false) {
            return $meta;
        }
        $meta = null;
        try {
            $size = self::make_request('/backup-size', [], 'GET', true);
        } catch (\Exception $e) {
            // Can't ask: nothing known, nothing refused here.
            return $meta = [];
        }
        foreach ((is_object($size) && isset($size->sessions) && is_array($size->sessions)) ? $size->sessions : [] as $session) {
            if (is_object($session) && isset($session->token) && (string) $session->token === (string) self::$session_id) {
                $meta = ['filtered' => !empty($session->filtered)];
                if (property_exists($session, 'site')) {
                    $meta['site'] = $session->site === null ? '' : (string) $session->site;
                }
                break;
            }
        }
        return $meta;
    }

    /**
     * Makes --site agree with the site the reused session was scanned for:
     * adopts it when --site is left out, refuses a different one. A source
     * that doesn't record it gets a warning, and refuses a mismatch itself
     * (session_site_mismatch) where it can tell.
     */
    private static function match_session_site() {
        $meta = self::session_meta();
        if ($meta === null) {
            echo "Error: the source has no finished scan with session ID " . self::$session_id . " (see 'disembark info " . self::$siteUrl . "').\n";
            exit(1);
        }
        if (!array_key_exists('site', $meta)) {
            if (self::$site !== '') {
                echo "Warning: this source doesn't record which site session " . self::$session_id . " was scanned for. It's used as a scan of site " . self::$site . "; if it wasn't, the backup mixes two sites.\n";
            }
            return;
        }
        $was  = trim(preg_replace('/[^A-Za-z0-9._-]+/', '-', $meta['site']), '-.');
        $want = self::site_key();
        if (self::$site === '') {
            if ($was === '') {
                return;
            }
            echo "Session " . self::$session_id . " was scanned for site $was; backing up site $was.\n";
            self::$site = $was;
            self::$source_caps = null;
            self::source_caps();
            return;
        }
        if ($was !== $want) {
            echo "Error: session " . self::$session_id . " was scanned for " . ($was === '' ? 'the whole install' : "site $was") . ", not site $want. Leave out --site to back up what the session scanned, or leave out --session-id to scan site $want.\n";
            exit(1);
        }
    }

    /** True when the source is v3 (it announces pacing in its preflight). */
    private static function source_is_v3() {
        return is_object(self::$source_caps) && !empty(self::$source_caps->pacing);
    }

    /**
     * Seconds to wait before retrying a request the host turned away:
     * the Retry-After it sent (seconds or an HTTP date, at most 5 minutes),
     * else a growing backoff.
     */
    private static function retry_wait($response, $attempt) {
        $wait = min(60, 2 * (2 ** ($attempt - 1)));
        if ($response && isset($response->headers['retry-after'])) {
            $value = trim((string) $response->headers['retry-after']);
            if (ctype_digit($value)) {
                $wait = (int) $value;
            } elseif (($when = strtotime($value)) !== false) {
                $wait = $when - time();
            }
        }
        return max(1, min(300, $wait));
    }

    /**
     * The site --site picked, as the source resolved it (its ID, even when
     * --site named an address), for folder names and the sync record.
     * '' without --site.
     */
    private static function site_key() {
        if (self::$site === '') {
            return '';
        }
        $caps = self::$source_caps;
        if (is_object($caps) && isset($caps->scope->site) && (string) $caps->scope->site !== '') {
            return (string) $caps->scope->site;
        }
        return trim(preg_replace('/[^A-Za-z0-9._-]+/', '-', self::$site), '-.');
    }

    /** ['site' => <id>] when --site picked one site of an install, else []. */
    private static function site_param() {
        return self::$site !== '' ? ['site' => self::$site] : [];
    }

    /**
     * Whether this backup is one site of a network or WP Freighter install:
     * --site, or the source's own address reached one (its preflight says).
     */
    private static function scoped_source() {
        if (self::$site !== '') {
            return true;
        }
        $caps = self::source_caps();
        return is_object($caps) && isset($caps->scope->site) && (string) $caps->scope->site !== '';
    }

    /** Whether a response is an HTML page rather than a REST answer. */
    private static function is_html_page($response) {
        $type = '';
        if (isset($response->headers['content-type'])) {
            $type = is_array($response->headers['content-type']) ? implode(',', $response->headers['content-type']) : (string) $response->headers['content-type'];
        }
        $body = ltrim((string) $response->body);
        if (stripos($type, 'application/json') !== false) {
            return false;
        }
        return stripos($type, 'text/html') !== false || stripos(substr($body, 0, 500), '<!doctype html') !== false || stripos(substr($body, 0, 500), '<html') !== false;
    }

    private static function make_request($endpoint, $payload = [], $method = 'POST', $quiet = false) {
        $headers = ['Content-Type' => 'application/json; charset=utf-8'] + self::api_headers();
        $method  = strtoupper($method);
        $data = array_merge(['token' => self::$token, 'backup_token' => self::$backup_token], $payload);
        // --site: the one site of a network or WP Freighter install to back
        // up or sync. (Import steps never take it: a restore goes into the
        // site the URL names.)
        if (self::$site !== '' && strpos($endpoint, '/import/') !== 0 && !isset($data['site'])) {
            $data['site'] = self::$site;
        }
        $url = self::rest_url($endpoint);
        if (self::$cookie) {
            // Critical: Cloudflare often blocks requests without a valid Referer matching the cookie's domain
            $headers['Referer'] = self::$siteUrl . '/'; 
            
            // Critical: Missing these standard headers flags the request as a bot
            $headers['Accept-Language'] = 'en-US,en;q=0.9';
            $headers['Accept'] = 'text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8';
        }
        $options = [
            'verify'    => false,
            'timeout'   => 600,
            'useragent' => self::$user_agent
        ];

        // /cleanup is POST on v3 (the token stays out of the URL); 2.9 only
        // answers GET.
        if ($endpoint === '/cleanup') {
            $method = self::source_is_v3() ? 'POST' : 'GET';
            $options['timeout'] = 120;
        }

        // Import steps on a resumable (v3) destination carry a request id, so
        // a resend after a dropped connection or a gateway timeout gets the
        // step's answer instead of running it twice. Without that (2.9), an
        // import step is never resent: it might run twice.
        $is_import = strpos($endpoint, '/import/') === 0 && $endpoint !== '/import/preflight';
        $resumable = is_object(self::$source_caps) && !empty(self::$source_caps->resumable);
        if ($is_import && $resumable && $method === 'POST' && !isset($data['request_id'])) {
            $data['request_id'] = self::new_session_id();
        }
        $max_attempts = ($is_import && !$resumable) ? 1 : 6;

        if ($method === 'POST') {
            // Increase timeout specifically for zip operations which can take longer
            if ($endpoint === '/zip-database' || $endpoint === '/zip-sync-files' || $endpoint === '/import/import-staged-sql') {
                $options['timeout'] = 1800; // 30 minutes
            } elseif (strpos($endpoint, '/export/database/') === 0 && isset($payload['parts'])) {
                $options['timeout'] = 1200; // 20 minutes for large table parts
            }
            $body = json_encode($data);
        } else {
            // For GET, build query params. v3 reads the token from the
            // X-Disembark-Token header, so it stays out of the URL (and the
            // host's access logs); 2.9 needs it in the query. rest_route
            // URLs already contain '?', so pick the separator accordingly.
            if (self::source_is_v3()) {
                unset($data['token']);
            }
            $query_params = http_build_query($data);
            $sep = (strpos($url, '?') !== false) ? '&' : '?';
            $url = $url . ($query_params !== '' ? $sep . $query_params : '');
        }

        for ($attempt = 1; ; $attempt++) {
            $response = null;
            try {
                $response = ($method === 'POST')
                    ? \WpOrg\Requests\Requests::post($url, $headers, $body, $options)
                    : \WpOrg\Requests\Requests::get($url, $headers, $options);
            } catch (\WpOrg\Requests\Exception $e) {
                if ($attempt < $max_attempts) {
                    $wait = self::retry_wait(null, $attempt);
                    if (!$quiet) {
                        echo "\nRequest to {$endpoint} failed ({$e->getMessage()}); retrying in {$wait}s...\n";
                    }
                    sleep($wait);
                    continue;
                }
                if (!$quiet) {
                    echo "Error: Request failed for {$endpoint}: {$e->getMessage()}\n";
                }
                throw $e; // Re-throw to allow potential cleanup in calling function
            }

            // Busy host (429/502/503/504), or a resumable step still running
            // from an earlier send (202): wait as asked, then send again.
            $running = $response->status_code === 202 && strpos((string) $response->body, 'disembark_step_running') !== false;
            if (($running || in_array($response->status_code, [429, 502, 503, 504], true)) && $attempt < $max_attempts) {
                $wait = $running ? 5 : self::retry_wait($response, $attempt);
                if (!$quiet) {
                    echo "\n" . ($running ? "{$endpoint} is still running on the server" : "{$endpoint} answered HTTP {$response->status_code}") . "; asking again in {$wait}s...\n";
                }
                sleep($wait);
                continue;
            }
            break;
        }

        // The destination took a database with plain permalinks partway
        // through (or never had pretty ones): /wp-json/ now answers with a
        // page instead of JSON. Carry on through ?rest_route=, as the
        // dashboard does, once.
        if (self::$rest_style !== 'rest_route' && in_array($response->status_code, [200, 404], true) && self::is_html_page($response)) {
            self::$rest_style = 'rest_route';
            if (!$quiet) {
                echo "      The site answers /wp-json/ with a page (plain permalinks): carrying on through ?rest_route=.\n";
            }
            return self::make_request($endpoint, $payload, $method, $quiet);
        }

        if ($response->status_code !== 200) {
            $errorMessage = "Error: Request to {$endpoint} failed. HTTP status: {$response->status_code}.";
            $errorBody = json_decode($response->body);
            self::$last_error = [
                'status'  => $response->status_code,
                'code'    => (is_object($errorBody) && isset($errorBody->code) && is_string($errorBody->code)) ? $errorBody->code : '',
                'message' => (is_object($errorBody) && isset($errorBody->message) && is_string($errorBody->message)) ? $errorBody->message : '',
            ];
            if (json_last_error() === JSON_ERROR_NONE && isset($errorBody->message)) {
                $errorMessage .= " Message: " . $errorBody->message;
            } else {
                $errorMessage .= " Response: " . substr($response->body, 0, 500);
            }
            // Quiet mode still throws — it just skips printing, for
            // best-effort probes against sites that predate the endpoint.
            if (!$quiet) {
                echo $errorMessage . "\n";
            }
            // Throw an exception instead of exiting directly to allow potential cleanup
            throw new \Exception("API request failed for {$endpoint}");
        }

        $decoded = json_decode($response->body);
        // Check if this endpoint is allowed to return a raw string (like a path or URL)
        $is_raw_endpoint = in_array($endpoint, ['/cleanup', '/zip-database', '/zip-sync-files'], true)
            || strpos($endpoint, '/export/database/') === 0;

        if (json_last_error() !== JSON_ERROR_NONE) {
            // Not JSON.
            // Is it an endpoint that *should* return a raw string?
            if (!empty(trim($response->body)) && $is_raw_endpoint) {
                return trim($response->body); // Return the raw body (e.g., URL)
            }
            // Not JSON and not an allowed raw endpoint, or it's empty
            if (!empty(trim($response->body))) {
                if (!$quiet) {
                    echo "Error: Could not decode JSON response from {$endpoint}. Response: " . substr($response->body, 0, 500) . "\n";
                }
                throw new \Exception("Invalid JSON response for {$endpoint}");
            }
            // Allow empty responses for cleanup
            if ($endpoint === '/cleanup') {
                return "Cleanup requested";
            }
        }

        // If it *is* valid JSON, but the API might have returned a JSON-encoded string (e.g. "path\/to\/file.sql")
        // json_decode will have correctly turned this into a PHP string.
        // If it was a JSON object/array, it will be a PHP object/array.
        return $decoded;
    }

    /**
     * An import step that works in pieces on a v3 destination: sent with
     * `paced` and the host's budget, and sent again while it answers
     * done: false. A 2.9 destination (no `pacing` in its preflight) runs the
     * whole step in one request, as before.
     */
    private static function paced_request($endpoint, $payload, $label = '', $quiet = false) {
        if (!self::source_is_v3()) {
            return self::make_request($endpoint, $payload, 'POST', $quiet);
        }
        $payload['paced']  = 1;
        $payload['budget'] = !empty(self::$source_caps->budget) ? (float) self::$source_caps->budget : 20;
        $rounds = 0;
        while (true) {
            $res = self::make_request($endpoint, $payload, 'POST', $quiet);
            if (!is_object($res) || !isset($res->done) || $res->done !== false) {
                if ($rounds > 0) {
                    echo "\n";
                }
                return $res;
            }
            $rounds++;
            $progress = '';
            foreach ([['tables_done', 'tables_total', 'tables'], ['entries_done', 'entries_total', 'entries'], ['placed', 'total', 'files'], ['parts_done', 'parts_total', 'parts'], ['files_done', 'files_total', 'files']] as $pair) {
                if (isset($res->{$pair[0]}, $res->{$pair[1]})) {
                    $progress = "{$res->{$pair[0]}} of {$res->{$pair[1]}} {$pair[2]}";
                    break;
                }
            }
            echo "\r  " . ($label ?: $endpoint) . ": working in pieces" . ($progress ? " ($progress)" : " (round $rounds)") . "...   ";
        }
    }

    /**
     * Runs the remote manifest generation process.
     * Can optionally request file checksums for sync operations.
     * @return array List of manifest chunk file objects.
     */
    private static function runManifestGeneration($include_checksums = false) {
        $files_manifests = [];
        try {
            echo "Running analysis (this may take a while)...\n";
            $exclude_files_string = implode("\n", self::$exclude_paths);

            $payload = [
                'exclude_files' => $exclude_files_string
            ];
            if ($include_checksums) {
                $payload['include_checksums'] = true;
            }

            // Step 1: Initiate
            // Simplified make_request signature: (endpoint, payload, method)
            self::make_request('/regenerate-manifest', ['step' => 'initiate'] + $payload, 'POST');
            echo "Initiated file scan.\n";

            // Step 2: Scan Loop
            $scan_complete = false;
            $last_scan_output = "";
            while (!$scan_complete) {
                $scan_response = self::make_request('/regenerate-manifest', ['step' => 'scan'] + $payload, 'POST');
                
                if (!is_object($scan_response) || !isset($scan_response->status)) {
                    throw new \Exception("Invalid response received during scan step.");
                }

                if ($scan_response->status === 'scan_complete') {
                    $scan_complete = true;
                    echo str_pad("", strlen($last_scan_output), " ") . "\r";
                    printf("Scanning complete. Analyzed %d directories.\n", $scan_response->total_dirs ?? 0);
                } else if (isset($scan_response->scanned_dirs) && isset($scan_response->total_dirs)) {
                    $last_scan_output = sprintf("Scanning... (%d / %d directories)", $scan_response->scanned_dirs, $scan_response->total_dirs);
                    echo $last_scan_output . "\r";
                }
                usleep(250000);
            }

            // Step 3: Chunkify
            echo "Chunkifying file list...\n";
            $chunk_response = self::make_request('/regenerate-manifest', ['step' => 'chunkify'] + $payload, 'POST');
            $total_chunks = $chunk_response->total_chunks ?? 0;
            
            if ($total_chunks === 0) {
                echo "No files found to analyze or an error occurred during chunkification.\n";
            } else {
                echo "File list divided into {$total_chunks} chunks.\n";
            }

            // Step 4: Process Chunks
            $last_chunk_output = "";
            for ($i = 1; $i <= $total_chunks; $i++) {
                $last_chunk_output = sprintf("Processing chunk %d of %d...", $i, $total_chunks);
                echo $last_chunk_output . "\r";
                self::make_request('/regenerate-manifest', ['step' => 'process_chunk', 'chunk' => $i] + $payload, 'POST');
                usleep(50000);
            }
            if ($total_chunks > 0) {
                echo str_pad("", strlen($last_chunk_output), " ") . "\r";
                echo "Chunk processing complete.\n";
            }

            // Step 5: Finalize
            $files_manifests = self::make_request('/regenerate-manifest', ['step' => 'finalize'] + $payload, 'POST');
            
            // Anything but a list is an error, never "no files": sync would
            // read an empty list as "everything was deleted on the source".
            if (!is_array($files_manifests)) {
                throw new \Exception("The source's file list came back in an unexpected format.");
            }
            echo "Analysis complete.\n";

        } catch (\Exception $e) {
            echo "Error during file analysis: {$e->getMessage()}\n";
            self::cleanupTemporaryFiles();
            exit(1);
        }

        return $files_manifests;
    }

    private static function displayBackupSummary($files_manifests) {
        // 1. Fetch database info (using simplified make_request)
        $all_tables = [];
        try {
            $all_tables = self::make_request('/database', [], 'GET');
            if (!is_array($all_tables)) $all_tables = [];
        } catch (\Exception $e) {
            echo "Error: Failed to fetch database info: {$e->getMessage()}\n";
            exit(1);
        }

        // 2. Calculate file stats
        $remainingFiles = empty($files_manifests) ? 0 : array_sum(array_column($files_manifests, 'count'));
        $remainingSize = empty($files_manifests) ? 0 : array_sum(array_column($files_manifests, 'size'));

        // 3. Calculate database stats
        $totalTables = count($all_tables);
        $totalDbSize = empty($all_tables) ? 0 : array_sum(array_column($all_tables, 'size'));
        $excludedTables = 0;
        $excludedDbSize = 0;
        $included_table_list = [];

        foreach ($all_tables as $table) {
            $table_size = isset($table->size) && is_numeric($table->size) ? (float)$table->size : 0;
            $is_excluded = false;
            
            // Check against self::$exclude_tables
            foreach (self::$exclude_tables as $pattern) {
                if (fnmatch($pattern, $table->table)) {
                    $is_excluded = true;
                    break;
                }
            }

            if ($is_excluded) {
                $excludedTables++;
                $excludedDbSize += $table_size;
            } else {
                $table->size = $table_size;
                $included_table_list[] = $table;
            }
        }
        $remainingTables = $totalTables - $excludedTables;
        $remainingDbSize = empty($included_table_list) ? 0 : array_sum(array_column($included_table_list, 'size'));

        // 4. Display results
        echo "\nBackup Preview: " . self::$siteUrl . "\n";
        echo "* Exclusions are applied server-side during analysis.\n";
        echo "* The summary below shows only files and tables scheduled for backup.\n\n";
        
        echo "File Backup Summary\n";
        printf("%-24s %12s %12s\n", "", "Count", "Size");
        printf("%-24s %12s %12s\n", str_repeat('-', 24), str_repeat('-', 12), str_repeat('-', 12));
        printf("%-24s %12s %12s\n", "Files to be Backed Up:", number_format($remainingFiles), self::humanFilesize($remainingSize));

        echo "\nDatabase Backup Summary\n";
        printf("%-24s %12s %12s\n", "", "Count", "Size");
        printf("%-24s %12s %12s\n", str_repeat('-', 24), str_repeat('-', 12), str_repeat('-', 12));
        printf("%-24s %12s %12s\n", "Total Tables:", number_format($totalTables), self::humanFilesize($totalDbSize));
        printf("%-24s %12s %12s\n", "Excluded Tables:", number_format($excludedTables), self::humanFilesize($excludedDbSize));
        printf("%-24s %12s %12s\n", "Tables to be Backed Up:", number_format($remainingTables), self::humanFilesize($remainingDbSize));
        echo "\n* This is an estimate. Actual backup size may vary.\n";
    }

    private static function runPreview($is_preview_mode) {

        // 1. Run the manifest generation
        $files_manifests = self::runManifestGeneration(false);

        // 2. Display the summary
        self::displayBackupSummary($files_manifests);

        // 3. Handle Preview Exit
        if ($is_preview_mode) {
            self::cleanupTemporaryFiles();
            exit(0);
        }

        // 4. Return the generated manifest for the actual backup
        return $files_manifests;
    }

    /**
     * Renders a CLI progress bar string.
     */
    private static function draw_progress_bar($done, $total, $width = 20) {
        if ($total < 1) return str_repeat(' ', $width + 7);
        $perc = min(100, round(($done / $total) * 100));
        $bar_filled = round(($width * $perc) / 100);
        $bar = '[' . str_repeat('=', $bar_filled) . str_repeat(' ', $width - $bar_filled) . ']';
        return sprintf("%s %3d%%", $bar, $perc);
    }

    /**
     * Helper function specifically for cleanup after preview or backup failure
     */
    private static function cleanupTemporaryFiles() {
        // Without a session id the source's /cleanup removes every backup
        // session on it, including other people's: never send that here.
        if (empty(self::$backup_token)) {
            return;
        }
        echo "Cleaning up temporary files on server...\n";
        try {
            $payload = ['backup_token' => self::$backup_token];
            self::make_request('/cleanup', $payload, 'POST'); // GET on a 2.9 source, see make_request()
        } catch (\Exception $e) {
            echo "Warning: Cleanup request failed: {$e->getMessage()}\n";
        }
    }

    /**
     * Helper to download large files via public URL.
     */
    private static function fetch_large_file_publicly($file, $local_destination) {
        $file_size_human = self::humanFilesize($file->size);
        echo "   > Large file detected ($file_size_human). Attempting public direct download...\n";
        
        $path_parts = explode('/', $file->name);
        $encoded_parts = array_map('rawurlencode', $path_parts);
        $public_url = self::$siteUrl . '/' . implode('/', $encoded_parts);

        echo "     Downloading: $public_url\n";
        try {
            self::download_file_direct($public_url, $local_destination);
            echo "     - Download complete.\n";
            return true;
        } catch (\Exception $e) {
            echo "     - Public download failed: {$e->getMessage()}. Falling back to stream...\n";
            return false;
        }
    }

    /**
     * Downloads a large file via the stream API in chunks (e.g., 50MB) to avoid PHP timeouts.
     */
    private static function download_file_chunked_stream($relative_path, $destination, $total_size) {
        $chunk_size = 50 * 1024 * 1024; // 50 MB chunks
        $offset = 0;
        $total_size = (int) $total_size;
        
        // Written to <file>.part and moved over the file only once every
        // byte is in, so a failed download never empties the good copy.
        $part = $destination . '.part';
        if (is_link($part)) @unlink($part);
        $fp = fopen($part, 'w');
        if (!$fp) throw new \Exception("Could not open local file for writing: $part");
        fclose($fp);

        $progress_bar_width = 20;
        while ($offset < $total_size) {
            $length = min($chunk_size, $total_size - $offset);
            
            // Calculate progress
            $percent = min(100, round(($offset / $total_size) * 100));
            $downloaded_human = self::humanFilesize($offset);
            $total_human = self::humanFilesize($total_size);
            
            echo str_pad("", 80, " ") . "\r"; // Clear line
            echo "     - Streaming Chunk: {$downloaded_human} / {$total_human} ({$percent}%)...\r";
            
            $attempts = 0;
            $max_attempts = 5;
            $chunk_success = false;
            $wait = 2;

            while ($attempts < $max_attempts && !$chunk_success) {
                $attempts++;
                try {
                    // UPDATED: Use self::$siteUrl
                    $endpoint_url = self::rest_url('/stream-file');
                    
                    // UPDATED: Use self::$token
                    $payload = json_encode([
                        'token' => self::$token, 
                        'file' => $relative_path,
                        'offset' => $offset,
                        'length' => $length
                    ] + self::site_param());

                    // App-password connections authenticate by header; v3
                    // also takes the token in X-Disembark-Token.
                    $headers = ['Content-Type' => 'application/json'] + self::api_headers();
                    
                    $options = [
                        'verify' => false,
                        'timeout' => 300, // 5 minutes per 50MB chunk should be plenty
                        'connect_timeout' => 30,
                        'useragent' => self::$user_agent,
                    ];
                    
                    $response = \WpOrg\Requests\Requests::post($endpoint_url, $headers, $payload, $options);

                    if (!$response->success) {
                        if ($response->status_code == 429 || $response->status_code == 503) {
                            $wait = self::retry_wait($response, $attempts);
                        }
                        throw new \Exception("HTTP {$response->status_code}");
                    }
                    
                    // A short chunk means the file changed or the answer was
                    // cut off: retry it rather than build a file with a hole.
                    if (strlen($response->body) != $length) {
                        throw new \Exception("got " . strlen($response->body) . " of $length bytes");
                    }

                    if (file_put_contents($part, $response->body, FILE_APPEND) !== $length) {
                        throw new \Exception("could not write to $part (is the disk full?)");
                    }
                    $chunk_success = true;

                } catch (\Exception $e) {
                    // Drop whatever part of this chunk made it to disk.
                    clearstatcache(true, $part);
                    if (file_exists($part) && filesize($part) > $offset) {
                        $h = fopen($part, 'r+');
                        if ($h) { ftruncate($h, $offset); fclose($h); }
                    }
                    if ($attempts < $max_attempts) {
                        echo str_pad("", 80, " ") . "\r"; 
                        echo "     - Retry ($attempts/$max_attempts) for offset $offset in {$wait}s...\r";
                        sleep($wait);
                        $wait = 2;
                    } else {
                        @unlink($part);
                        throw new \Exception("Failed to download chunk at offset $offset: " . $e->getMessage());
                    }
                }
            }
            
            $offset += $length;
        }

        clearstatcache(true, $part);
        $got = file_exists($part) ? filesize($part) : 0;
        if ($got !== $total_size) {
            @unlink($part);
            throw new \Exception("The streamed file is $got bytes, not the $total_size listed.");
        }
        if (!rename($part, $destination)) {
            @unlink($part);
            throw new \Exception("Could not move the download into place at $destination.");
        }
        
        echo str_pad("", 80, " ") . "\r";
        $total_human = self::humanFilesize($total_size);
        echo "     - Streaming complete: {$total_human} downloaded.\n";
    }

    /**
     * Processes the database backup using hybrid batching.
     *
     * @param array $tables_to_backup List of table objects to be backed up.
     * @param string $db_export_file The final, local SQL file path to append to.
     * @param string $local_db_parts_path A temporary directory to store downloaded SQL chunks.
     * @throws \Exception
     */
    private static function processDatabaseBackup($tables_to_backup, $db_export_file, $local_db_parts_path) {
        
        echo "Backing up database tables...\n";
        
        // Use static thresholds
        $max_size = self::$db_max_size;
        $max_rows = self::$db_max_rows;

        // --- Hybrid Batching Logic ---
        $large_tables = [];
        $small_tables = [];
        foreach ($tables_to_backup as $table) {
            $table_size = isset($table->size) && is_numeric($table->size) ? (float)$table->size : 0;
            $row_count = isset($table->row_count) && is_numeric($table->row_count) ? (int)$table->row_count : 0;
            if (($table_size > $max_size || $row_count > $max_rows) && $row_count > 0) {
                $parts_by_size = ceil($table_size / $max_size);
                $parts_by_rows = ceil($row_count / $max_rows);
                $parts = max($parts_by_size, $parts_by_rows);
                
                $table->parts = $parts;
                $table->current = 0;
                $table->rows_per_part = ceil($row_count / $parts);
                $large_tables[] = $table;
            } else {
                $table->parts = 0;
                $small_tables[] = $table;
            }
        }

        $small_table_batches = [];
        $current_batch = [];
        $current_batch_size = 0;
        foreach ($small_tables as $table) {
            $table_size = isset($table->size) && is_numeric($table->size) ? (float)$table->size : 0;
            if ($current_batch_size + $table_size > $max_size && !empty($current_batch)) {
                $small_table_batches[] = $current_batch;
                $current_batch = [];
                $current_batch_size = 0;
            }
            $current_batch[] = $table;
            $current_batch_size += $table_size;
        }
        if (!empty($current_batch)) {
            $small_table_batches[] = $current_batch;
        }
        // --- End Hybrid Batching ---

        // Calculate total steps
        $total_db_steps = count($small_table_batches);
        foreach ($large_tables as $table) {
            $total_db_steps += ($table->parts > 0) ? $table->parts : 1;
        }
        $current_db_step = 0;
        
        // --- Loop 1: Process small table batches ---
        foreach ($small_table_batches as $batch) {
            $current_db_step++;
            $table_names = array_column($batch, 'table');
            $batch_size = array_sum(array_column($batch, 'size'));
            $progress_message = sprintf(" - Exporting batch %d/%d (%d tables, %s)", $current_db_step, $total_db_steps, count($batch), self::humanFilesize($batch_size));
            echo $progress_message . "...\r";

            // Simplified make_request
            $file_url = self::make_request("/export-database-batch", ['tables' => $table_names], 'POST');
            
            if (strpos($file_url, 'http') !== 0) {
                throw new \Exception("Export failed for batch, did not receive a valid URL. Got: $file_url");
            }
            $file_name = basename($file_url);
            $local_file_path = $local_db_parts_path . '/' . $file_name;

            $parsed_url = parse_url($file_url);
            $relative_path = ltrim($parsed_url['path'], '/');
            
            // Simplified download call
            self::download_db_file($relative_path, $local_file_path);

            self::append_file($local_file_path, $db_export_file);
            unlink($local_file_path);

            self::make_request('/cleanup-file', ['file_name' => $file_name], 'POST');
            echo $progress_message . " - Done.\n";
            usleep(50000);
        }

        // --- Loop 2: Process large tables ---
        foreach ($large_tables as $table) {
            if (!isset($table->table)) {
                echo "\nWarning: Skipping invalid table data entry in backup.\n";
                continue;
            }

            for ($part = 1; $part <= $table->parts; $part++) {
                $current_db_step++;
                $total_table_size = (float)$table->size;
                $row_count = isset($table->row_count) && is_numeric($table->row_count) ? (int)$table->row_count : 0;
                
                $current_part_size = 0;
                $parts_by_size = ($max_size > 0) ? ceil($total_table_size / $max_size) : 1;
                $parts_by_rows = ($max_rows > 0) ? ceil($row_count / $max_rows) : 1;
                
                if ($parts_by_rows > $parts_by_size) {
                    $current_part_size = $total_table_size / $table->parts;
                } else {
                    $current_part_size = $max_size;
                }

                if ($part == $table->parts) {
                    $previous_parts_size = $current_part_size * ($table->parts - 1);
                    $current_part_size = $total_table_size - $previous_parts_size;
                }
                
                $description = sprintf("%s %d/%d", $table->table, $part, $table->parts);
                $size_string = self::humanFilesize(max(0, $current_part_size));
                $progress_message = sprintf(" - Exporting batch %d/%d (%s, %s)", $current_db_step, $total_db_steps, $description, $size_string);
                echo $progress_message . "...\r";
                
                $part_data = ['parts' => $part, 'rows_per_part' => $table->rows_per_part];
                $file_url = self::make_request("/export/database/{$table->table}", $part_data, 'POST');
                
                if (strpos($file_url, 'http') !== 0) {
                    throw new \Exception("Export failed, did not receive a valid URL. Got: $file_url");
                }
                $file_name = basename($file_url);
                $local_file_path = $local_db_parts_path . '/' . $file_name;

                $parsed_url = parse_url($file_url);
                $relative_path = ltrim($parsed_url['path'], '/');
                
                self::download_db_file($relative_path, $local_file_path);
                
                self::append_file($local_file_path, $db_export_file);
                unlink($local_file_path);

                self::make_request('/cleanup-file', ['file_name' => $file_name], 'POST');
                echo $progress_message . " - Done.\n";
                usleep(50000);
            }
        }
        echo "Database export and download complete.\n";
    }

    /**
     * Appends one downloaded dump part to the dump, a stream at a time, so a
     * 200 MB part never has to fit in PHP's memory. Throws when the part
     * can't be read or the dump can't take all of it (a full disk), so a
     * short dump is never kept as whole.
     */
    private static function append_file($from, $to) {
        $size = @filesize($from);
        $in   = @fopen($from, 'rb');
        if (!$in) {
            throw new \Exception("Could not read the downloaded part $from.");
        }
        $out = @fopen($to, 'ab');
        if (!$out) {
            fclose($in);
            throw new \Exception("Could not open $to to add the downloaded part.");
        }
        $copied = stream_copy_to_stream($in, $out);
        $flushed = fflush($out);
        fclose($in);
        $closed = fclose($out);
        if ($copied === false || ($size !== false && $copied !== $size) || !$flushed || !$closed) {
            throw new \Exception("Could not write all of " . basename($from) . " into " . basename($to) . " (is the disk full?).");
        }
    }

   /**
     * Synchronizes the remote site to a local folder (Remote -> Local).
     */
    /**
     * Writes disembark-source.json (origin home URL, site URL and table prefix)
     * into $dir so `disembark restore` knows what to remap. Non-fatal: restore
     * can still be pointed with --source-url / --source-prefix.
     */
    private static function write_source_meta($dir) {
        // Pre-2.8 sources don't have the preflight; say so in one line rather
        // than print a scary 404 on every backup.
        $src_info = self::source_caps();
        if (!is_object($src_info)) {
            echo "Note: source metadata not captured (source may be running pre-2.8 Disembark); 'disembark restore' will need --source-url.\n";
            return;
        }
        $source_meta = [
            'home_url'  => $src_info->home_url ?? '',
            'site_url'  => $src_info->site_url ?? '',
            'db_prefix' => $src_info->db_prefix ?? '',
            'captured'  => date('c'),
        ];
        // One site of a network or WP Freighter install: its own address and
        // the prefix its tables are exported under, for restore to remap.
        if (isset($src_info->scope) && is_object($src_info->scope) && !empty($src_info->scope->home)) {
            $source_meta['home_url'] = rtrim((string) $src_info->scope->home, '/');
            $source_meta['site_url'] = $source_meta['home_url'];
            if (!empty($src_info->scope->prefix)) {
                $source_meta['db_prefix'] = (string) $src_info->scope->prefix;
            }
        }
        // What kind of install it came from, and which one site of it (when
        // the backup is of one site), so restore can refuse a whole network
        // or WP Freighter install before changing anything.
        if (isset($src_info->profile)) {
            $source_meta['profile'] = $src_info->profile;
        }
        if (isset($src_info->install) && is_object($src_info->install)) {
            $source_meta['install'] = ['kind' => $src_info->install->kind ?? '', 'total' => (int) ($src_info->install->total ?? 0), 'home' => $src_info->install->home ?? ''];
        }
        if (self::$site !== '') {
            $source_meta['scope'] = self::$site;
        } elseif (isset($src_info->scope->site) && (string) $src_info->scope->site !== '') {
            // The site's own address reached one site of the install.
            $source_meta['scope'] = (string) $src_info->scope->site;
        }
        file_put_contents(rtrim($dir, '/') . '/disembark-source.json', json_encode($source_meta, JSON_PRETTY_PRINT));
    }

    private static function sync($folder) {

        // 1. Setup Session / Backup Token
        if (self::$session_id) {
            self::$backup_token = self::$session_id;
            echo "Reusing backup session: " . self::$backup_token . "\n";
            if (!self::$skip_checksums) {
                self::$skip_checksums = true;
                echo " - Forcing --skip-checksums (GUI sessions do not contain checksum data).\n";
            }
        } else {
            self::$backup_token = self::new_session_id();
        }

        // 2. Folder Setup
        $is_initial_sync = !is_dir($folder);
        if ($is_initial_sync) {
            echo "Performing initial sync to new folder: $folder\n";
            if (!mkdir($folder, 0755, true)) {
                echo "Error: Could not create folder at $folder.\n";
                exit(1);
            }
        } else {
            echo "Performing subsequent sync to existing folder: $folder\n";
        }

        $local_db_parts_path = $folder . '/.disembark-db-parts';
        $db_export_file = $folder . '/database.sql';
        // The dump is written beside the last one and swapped in when whole,
        // so a sync that stops partway leaves the previous database.sql.
        $db_part_file = $db_export_file . '.part';
        
        // Initialize Stats
        $transferred_bytes = 0;
        $transferred_files = 0;
        $deleted_files = 0;

        try {
            // --- Database Sync ---
            if (!self::$skip_db) {
                echo "Starting database sync...\n";
                foreach ([$db_export_file, $db_part_file, $local_db_parts_path] as $own) {
                    if (is_link($own)) {
                        throw new \Exception("$own is a symlink; sync won't write through it.");
                    }
                }
                if (!is_dir($local_db_parts_path) && !mkdir($local_db_parts_path, 0755, true)) {
                    throw new \Exception("Could not create temp DB directory.");
                }
                
                if (file_put_contents($db_part_file, "/*!40101 SET NAMES utf8mb4 */;\nSET sql_mode='NO_AUTO_VALUE_ON_ZERO';\n") === false) {
                    throw new \Exception("Could not write to local SQL file.");
                }

                $database = self::make_request('/database', [], 'GET');
                if (!is_array($database)) throw new \Exception("Invalid database list received.");

                // --exclude-tables applies to sync too (2.9 ignored it here).
                if (!empty(self::$exclude_tables)) {
                    $database = array_values(array_filter($database, function ($table) {
                        foreach (self::$exclude_tables as $pattern) {
                            if (isset($table->table) && fnmatch($pattern, $table->table)) {
                                return false;
                            }
                        }
                        return true;
                    }));
                }

                // Tally Database Stats
                foreach ($database as $tbl) {
                    $transferred_bytes += (isset($tbl->size) ? (float)$tbl->size : 0);
                }

                self::processDatabaseBackup($database, $db_part_file, $local_db_parts_path);
                self::delete_directory($local_db_parts_path);
                if (!rename($db_part_file, $db_export_file)) {
                    throw new \Exception("Could not move the new dump into place as database.sql.");
                }
            } else {
                echo "Skipping database sync as requested.\n";
            }

            // --- File Sync ---
            if (!self::$skip_files) {
                $files_manifest_chunks = [];
                if (self::$session_id) {
                    echo "Fetching existing manifest for sync...\n";
                    try {
                        $files_manifest_chunks = self::make_request('/manifest', [], 'GET');
                        if (!is_array($files_manifest_chunks)) {
                            throw new \Exception("Could not fetch or parse existing manifest.");
                        }
                        echo "Successfully fetched manifest with " . count($files_manifest_chunks) . " file chunks.\n";
                    } catch (\Exception $e) {
                        echo "Error fetching manifest: {$e->getMessage()}\n";
                        exit(1);
                    }
                } else {
                    echo "Starting file sync analysis...\n";
                    $include_checksums = (!$is_initial_sync && !self::$skip_checksums);
                    $files_manifest_chunks = self::runManifestGeneration($include_checksums);
                }

                echo "Fetching remote file manifest...\n";
                list($remote_files_map, , $report) = self::fetch_manifests_parallel($files_manifest_chunks);
                echo str_pad("", 80, " ") . "\r";

                // A list we couldn't read whole would make every file in the
                // missing part look deleted on the source. Stop instead.
                if (!$report['complete']) {
                    throw new \Exception("The source's file list is incomplete (" . implode('; ', $report['problems']) . "). No files were changed or deleted; run the sync again.");
                }
                $listed = $report['listed'];
                $remote_files_map = self::filter_writable_files($remote_files_map, $folder, true);
                $previous = $is_initial_sync ? null : self::read_sync_state($folder);

                if ($is_initial_sync) {
                    echo "Performing initial file download (Optimized)...\n";
                    $files_to_download = array_values($remote_files_map);
                } else {
                    // Subsequent Sync (Diff)
                    echo "Generating local file manifest...\n";
                    $local_files_map = self::generate_local_manifest($folder, self::$skip_checksums);
                    echo "Comparing manifests and syncing changes...\n";
                    
                    $files_to_download = [];
                    foreach ($remote_files_map as $path => $remote_file) {
                        $local_file = $local_files_map[$path] ?? null;
                        $should_download = false;
                        if (self::$skip_checksums) {
                            if (!$local_file || (isset($local_file->size) && isset($remote_file->size) && (int) $local_file->size !== (int) $remote_file->size)) {
                                $should_download = true;
                            }
                        } else {
                            if (!$local_file || !isset($remote_file->checksum) || $local_file->checksum !== $remote_file->checksum) {
                                $should_download = true;
                            }
                        }
                        if ($should_download) $files_to_download[] = $remote_file;
                    }
                }

                // Stats
                $total_bytes_to_sync = 0;
                foreach ($files_to_download as $f) {
                    $total_bytes_to_sync += (isset($f->size) ? (float)$f->size : 0);
                }
                self::$global_bytes_total = $total_bytes_to_sync;
                self::$global_bytes_processed = 0;

                $transferred_bytes += $total_bytes_to_sync;
                $transferred_files += count($files_to_download);

                if (!empty($files_to_download)) {
                    echo " - Syncing " . count($files_to_download) . " new/changed file(s)...\n";
                    
                    $file_chunks = [];
                    $current_chunk = [];
                    $current_chunk_size = 0;
                    $large_files_parallel_queue = [];
                    foreach ($files_to_download as $file) {
                        $fsize = $file->size ?? 0;
                        
                        if ($fsize > self::$large_file_threshold) {
                            $large_files_parallel_queue[] = $file;
                            continue;
                        }
                        
                        if (($current_chunk_size + $fsize > self::$file_chunk_max_size) || (count($current_chunk) >= self::$file_chunk_size)) {
                            $file_chunks[] = $current_chunk;
                            $current_chunk = [$file];
                            $current_chunk_size = $fsize;
                        } else {
                            $current_chunk[] = $file;
                            $current_chunk_size += $fsize;
                        }
                    }
                    if (!empty($current_chunk)) $file_chunks[] = $current_chunk;

                    if (!empty($large_files_parallel_queue)) {
                        self::download_files_parallel($large_files_parallel_queue, $folder);
                    }

                    // Use the new Parallel State Machine
                    if (!empty($file_chunks)) {
                        self::sync_chunks_parallel($file_chunks, $folder);
                    }

                    // Wait for background extractions before applying deletions
                    // or writing sync state, and collect anything they refused.
                    self::wait_for_extractions($folder, 60);
                    self::verify_arrived($files_to_download, $folder);

                    echo " - All sync chunks processed.\n";
                } else {
                    echo " - No new or changed files to download.\n";
                }

                // Deletions: only files the source listed at the last sync
                // and no longer lists. Never a file sync didn't bring (yours),
                // an excluded path, or anything on an incomplete or empty list.
                // A reused session's list is whatever that scan covered
                // (folders left out with -x, or one site of a network), not
                // necessarily the whole source: nothing it leaves out can be
                // taken as deleted, and the sync record stays as it was.
                if (self::$session_id) {
                    if (!$is_initial_sync) {
                        $meta = self::session_meta();
                        echo " - Reused session" . (!empty($meta['filtered']) ? ' (scanned with folders left out)' : '') . ": nothing deleted locally and the sync record is kept; run a sync without --session-id to remove files deleted on the source.\n";
                    }
                } else {
                    if (!$is_initial_sync) {
                        $deleted_files = self::apply_source_deletions($folder, $previous, $listed);
                    }

                    // Remember what the source listed, for the next sync's
                    // deletions. An empty list keeps the last record.
                    if (!empty($listed)) {
                        self::write_sync_state($folder, $listed, $previous);
                    }
                }
                echo "File sync complete.\n";
            } else {
                echo "Skipping file sync as requested.\n";
            }
        } catch (\Throwable $e) {
            echo "\033[?25h";
            echo "\nSync failed: {$e->getMessage()}\n";
            @unlink($db_part_file);
            if (!self::$session_id) {
                self::cleanupTemporaryFiles();
            }
            exit(1);
        }

        if (!self::$session_id) {
            self::cleanupTemporaryFiles();
        } else {
            echo "\nSkipping remote cleanup to preserve UI session files.\n";
        }

        // Record the origin URL and table prefix (as backup does) so the mirror
        // can be restored without --source-url / --source-prefix.
        self::write_source_meta($folder);

        $had_failures = self::report_failures();

        // Final Output with Stats
        echo $had_failures ? "\nSync Finished With Errors\n" : "\nSync Completed Successfully\n";
        echo "-----------------------------\n";
        printf("%-15s %s\n", "Destination:", $folder);
        printf("%-15s %s\n", "Transferred:", self::humanFilesize($transferred_bytes));
        printf("%-15s %s\n", "Items:", number_format($transferred_files));
        printf("%-15s %s\n", "Deleted:", number_format($deleted_files));
        echo "\n";
        if ($had_failures) {
            exit(1);
        }
    }

    /** A site address without scheme, www. or trailing slash, for comparing. */
    private static function normalize_site($url) {
        return preg_replace('#^https?://(www\.)?#i', '', rtrim(strtolower((string) $url), '/'));
    }

    /**
     * The files the source listed at the last sync into $folder, as a set,
     * or null when there's no usable record (none yet, unreadable, or kept
     * for a different source). Without one, nothing is deleted.
     */
    private static function read_sync_state($folder) {
        $file = rtrim($folder, '/') . '/' . self::SYNC_STATE;
        if (!file_exists($file)) {
            echo " - No sync record in this folder yet (first sync with CLI 3.0): nothing will be deleted this time.\n";
            return null;
        }
        if (is_link($file) || is_link(dirname($file))) {
            echo " - Warning: the sync record is a symlink; ignoring it, so nothing will be deleted.\n";
            return null;
        }
        $state = json_decode((string) file_get_contents($file));
        if (!is_object($state) || !isset($state->files) || !is_array($state->files)) {
            echo " - Warning: the sync record is unreadable; nothing will be deleted this time.\n";
            return null;
        }
        if (self::normalize_site($state->source ?? '') !== self::normalize_site(self::$siteUrl)) {
            echo " - Warning: this folder was last synced from " . ($state->source ?? 'another site') . "; nothing will be deleted this time.\n";
            return null;
        }
        // --site picks one site of a network or WP Freighter install at the
        // same address: a record kept for another site (or the whole
        // install) says nothing about this one's deletions.
        $was = isset($state->site) ? (string) $state->site : '';
        if ($was !== self::site_key()) {
            echo " - Warning: this folder was last synced from " . ($was === '' ? 'the whole of ' . ($state->source ?? 'the site') : 'site ' . $was . ' of ' . ($state->source ?? 'the site')) . "; nothing will be deleted this time.\n";
            return null;
        }
        return array_fill_keys(array_filter($state->files, 'is_string'), true);
    }

    /**
     * Saves what the source listed this time. Paths excluded this run (-x)
     * keep their entries from the last record, so dropping the -x later still
     * knows they came from the source. Written to a temp file and moved into
     * place, so a stopped sync never leaves half a record.
     */
    private static function write_sync_state($folder, $listed, $previous) {
        $files = $listed;
        foreach ((array) $previous as $path => $unused) {
            if (self::is_excluded($path)) {
                $files[$path] = true;
            }
        }
        $file = rtrim($folder, '/') . '/' . self::SYNC_STATE;
        $dir  = dirname($file);
        if (is_link($dir) || (!is_dir($dir) && !mkdir($dir, 0755, true))) {
            echo " - Warning: could not save the sync record in $dir; the next sync won't delete anything.\n";
            return;
        }
        $tmp  = $file . '.tmp';
        $json = json_encode([
            'version' => 1,
            'source'  => rtrim(self::$siteUrl, '/'),
            'site'    => self::site_key(),
            'synced'  => date('c'),
            'files'   => array_keys($files),
        ], JSON_UNESCAPED_SLASHES);
        if (is_link($tmp) || is_link($file) || file_put_contents($tmp, $json) === false || !rename($tmp, $file)) {
            @unlink($tmp);
            echo " - Warning: could not save the sync record; the next sync won't delete anything.\n";
        }
    }

    /**
     * Deletes local copies of files deleted on the source since the last
     * sync: listed then ($previous), not listed now ($listed), not excluded,
     * a plain file at a safe path inside the folder. Returns how many.
     */
    private static function apply_source_deletions($folder, $previous, $listed) {
        if ($previous === null) {
            return 0;
        }
        if (empty($listed)) {
            echo " - The source listed no files: nothing deleted (the last sync record is kept).\n";
            return 0;
        }
        $real_root = realpath($folder);
        $deleted   = 0;
        $kept      = [];
        foreach ($previous as $path => $unused) {
            $path = (string) $path;
            if (isset($listed[$path]) || self::is_excluded($path) || self::is_reserved_sync_path($path)) {
                continue;
            }
            if ($real_root === false || !self::local_path_safe($real_root, $path)) {
                $kept[] = "$path (unsafe path or a symlink on the way)";
                continue;
            }
            $full = $real_root . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $path);
            if (is_link($full) || !is_file($full)) {
                continue; // already gone, or not a plain file sync wrote
            }
            echo " - Removing (deleted on the source): $path\n";
            if (@unlink($full)) {
                $deleted++;
                self::remove_emptied_parents($real_root, $path);
            } else {
                $kept[] = "$path (could not delete)";
            }
        }
        foreach ($kept as $line) {
            echo " - Kept: $line\n";
        }
        return $deleted;
    }

    /**
     * Processes zip chunks in parallel using a state machine (Zip -> Download -> Background Unzip).
     * Concurrency: 2 (Keeps pressure on server without overloading).
     */
    private static function sync_chunks_parallel($chunks, $folder) {
        // Increase concurrency since unzip is now non-blocking
        $max_concurrency = 2;
        $max_retries = 3;
        $mh = curl_multi_init();
        
        // 1. Prepare Queue
        $queue = [];
        $chunk_values = array_values($chunks);
        foreach ($chunk_values as $i => $files) {
            $queue[] = [
                'files' => $files,
                'attempts' => 0,
                'id' => $i + 1 // Stable ID for UI
            ];
        }
        
        $total_chunks = count($queue);
        $fallback_chunks = [];
        $active_transfers = [];
        $retry_after = [];
        $slots = array_fill(0, $max_concurrency, null); 

        echo "\033[?25l";
        echo " - Starting parallel sync (Concurrency: $max_concurrency, Retries: $max_retries)...\n";
        echo str_repeat("\n", $max_concurrency);
        echo "\033[{$max_concurrency}A";

        do {
            // 2. REFILL SLOTS
            while (count($active_transfers) < $max_concurrency && !empty($queue)) {
                $slot_idx = array_search(null, $slots);
                if ($slot_idx === false) $slot_idx = count($active_transfers);
                
                // Get Job
                $job = array_shift($queue);
                $job['attempts']++;
                
                // Start STAGE_ZIP
                $url = self::rest_url("/zip-sync-files");
                $payload = json_encode([
                    'token' => self::$token, 
                    'backup_token' => self::$backup_token, 
                    'files' => $job['files']
                ] + self::site_param());

                $ch = curl_init($url);
                
                if ($ch === false) {
                    $fallback_chunks[] = $job['files'];
                    continue;
                }

                curl_setopt($ch, CURLOPT_POST, 1);
                curl_setopt($ch, CURLOPT_POSTFIELDS, $payload);
                // Same auth as every API call: an app-password connection
                // sent none here before 3.0.
                curl_setopt($ch, CURLOPT_HTTPHEADER, self::api_header_lines(['Content-Type' => 'application/json']));
                curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
                curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
                curl_setopt($ch, CURLOPT_TIMEOUT, 1800);
                curl_setopt($ch, CURLOPT_USERAGENT, self::$user_agent);
                // A host that rate-limits says how long to wait.
                curl_setopt($ch, CURLOPT_HEADERFUNCTION, function ($c, $line) use (&$retry_after) {
                    if (stripos($line, 'retry-after:') === 0) {
                        $retry_after[is_object($c) ? spl_object_id($c) : (int) $c] = trim(substr($line, 12));
                    }
                    return strlen($line);
                });
                curl_multi_add_handle($mh, $ch);
                $ch_id = is_object($ch) ? spl_object_id($ch) : (int)$ch;
                unset($retry_after[$ch_id]);
                
                $active_transfers[$ch_id] = [
                    'state' => 'ZIP',
                    'chunk_idx' => $job['id'],
                    'slot' => $slot_idx,
                    'job' => $job, 
                    'file_count' => count($job['files'])
                ];
                $slots[$slot_idx] = $ch_id;
            }

            // 3. EXECUTE
            curl_multi_exec($mh, $running);
            if ($running > 0 && curl_multi_select($mh, 0.1) === -1) {
                usleep(100);
            }

            // 4. UPDATE UI
            foreach ($active_transfers as $data) {
                $slot = $data['slot'];
                $line = $slot + 1;
                $idx = $data['chunk_idx'];
                $count = $data['file_count'];
                $attempt = $data['job']['attempts'];
                $retry_label = ($attempt > 1) ? "[Retry] " : "";
                $label_num = $slot + 1;

                // --- UI ALIGNMENT LOGIC ---
                $status_text = "";
                $bar_output = "";
                $size_output = "";

                if ($data['state'] === 'ZIP') {
                    $status_text = "Chunk $idx/$total_chunks ($count files): {$retry_label}Requesting Zip...";
                } elseif ($data['state'] === 'DL') {
                    $d = curl_getinfo($data['handle'], CURLINFO_SIZE_DOWNLOAD);
                    $t = curl_getinfo($data['handle'], CURLINFO_CONTENT_LENGTH_DOWNLOAD);
                    
                    $status_text = "Chunk $idx/$total_chunks: {$retry_label}Downloading...";
                    $bar_output = ($t > 0) ? self::draw_progress_bar($d, $t, 15) : '';
                    $size_output = self::humanFilesize($d);
                } elseif ($data['state'] === 'UNZIP') {
                    $status_text = "Chunk $idx/$total_chunks: Background Extracting...";
                }

                if (strlen($status_text) > 56) $status_text = '...' . substr($status_text, -53);
                $status_padded = str_pad($status_text, 56);
                
                echo "\033[{$line}B\r\033[K {$label_num}: {$status_padded} {$bar_output} {$size_output}\033[{$line}A";
            }

            // 5. PROCESS SYNCHRONOUS TASKS (UNZIP)
            foreach ($active_transfers as $id => $data) {
                if ($data['state'] === 'UNZIP') {
                    
                    $slot = $data['slot'];
                    $line = $slot + 1;
                    $label_num = $slot + 1;

                    try {
                        // --- NON-BLOCKING BACKGROUND EXTRACTION ---
                        // We use php -r to spawn a detached process that handles ZipArchive and unlink.
                        $zip_path = $data['file_path'];
                        $dest_path = $folder;

                        // Escape for shell safety
                        $safe_zip = escapeshellarg($zip_path);
                        $safe_dest = escapeshellarg($dest_path);

                        // Unpacked by a separate PHP process (see
                        // extractor_script()) that never writes outside
                        // the folder or through a symlink, then deletes the zip.
                        $cmd = sprintf('%s %s %s %s > /dev/null 2>&1 &', escapeshellarg(PHP_BINARY), escapeshellarg(self::extractor_script()), $safe_zip, $safe_dest);
                        exec($cmd);
                        self::$pending_extractions[] = $zip_path;

                        // Update global stats immediately (based on zip size)
                        // Note: Uncompressed size would be more accurate but requires reading the zip, which blocks.
                        self::$global_bytes_processed += filesize($zip_path);

                        $msg_text = "Chunk {$data['chunk_idx']} backgrounded.";
                        $msg_padded = str_pad($msg_text, 56);
                        echo "\033[{$line}B\r\033[K {$label_num}: {$msg_padded}\033[{$line}A";

                        // Cleanup remote file immediately
                        try {
                            self::make_request('/cleanup-file', ['file_name' => $data['file_name']], 'POST');
                        } catch (\Exception $e) { }
                        
                    } catch (\Exception $e) {
                         // Should rarely happen with exec, but handle logic errors
                         $fallback_chunks[] = $data['job']['files'];
                         echo "\033[{$line}B\r\033[K {$label_num}: Background Launch Failed.\033[{$line}A";
                    }

                    // Done with this job immediately - DO NOT WAIT for unzip
                    $slots[$slot] = null;
                    unset($active_transfers[$id]);
                }
            }

            // 6. CHECK ASYNC COMPLETION (cURL)
            while ($info = curl_multi_info_read($mh)) {
                $ch = $info['handle'];
                $ch_id = is_object($ch) ? spl_object_id($ch) : (int)$ch;
                
                if (!isset($active_transfers[$ch_id])) continue;
                
                $data = $active_transfers[$ch_id];
                $slot = $data['slot'];
                $line = $slot + 1;
                $label_num = $slot + 1;
                
                curl_multi_remove_handle($mh, $ch);
                if ($data['state'] === 'ZIP') {
                    // ZIP FINISHED logic...
                    $raw_response = curl_multi_getcontent($ch);
                    $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
                    
                    if (is_resource($ch)) curl_close($ch);
                    
                    $zip_url = null;
                    $decoded = json_decode($raw_response);
                    if (json_last_error() === JSON_ERROR_NONE && is_string($decoded)) {
                        $zip_url = $decoded;
                    } elseif (strpos($raw_response, 'http') === 0) {
                        $zip_url = trim($raw_response);
                    }

                    if ($http_code === 200 && !empty($zip_url) && strpos($zip_url, 'http') === 0) {
                        // SUCCESS -> TRANSITION TO DOWNLOAD
                        $fname = basename(parse_url($zip_url, PHP_URL_PATH) ?: $zip_url);
                        // Our own name locally: the server's could match a
                        // site file in the folder (the zip is deleted after).
                        $lpath = $folder . '/sync-files-' . self::new_session_id() . '.zip';
                        
                        $fp = fopen($lpath, 'w+');
                        $ch_dl = curl_init($zip_url);
                        if ($fp === false || $ch_dl === false) {
                            if ($fp) fclose($fp);
                            if ($ch_dl) curl_close($ch_dl);
                            $slots[$slot] = null;
                            unset($active_transfers[$ch_id]);
                            $fallback_chunks[] = $data['job']['files'];
                            echo "\033[{$line}B\r\033[K {$label_num}: Local IO Error. Added to fallback.\033[{$line}A";
                        } else {
                            curl_setopt($ch_dl, CURLOPT_FILE, $fp);
                            curl_setopt($ch_dl, CURLOPT_SSL_VERIFYPEER, false);
                            curl_setopt($ch_dl, CURLOPT_FOLLOWLOCATION, true);
                            curl_setopt($ch_dl, CURLOPT_TIMEOUT, 3600);
                            curl_setopt($ch_dl, CURLOPT_USERAGENT, self::$user_agent);
                            curl_multi_add_handle($mh, $ch_dl);
                            
                            unset($active_transfers[$ch_id]);
                            $new_id = is_object($ch_dl) ? spl_object_id($ch_dl) : (int)$ch_dl;
                            $active_transfers[$new_id] = $data;
                            $active_transfers[$new_id]['state'] = 'DL';
                            $active_transfers[$new_id]['file_path'] = $lpath;
                            $active_transfers[$new_id]['file_name'] = $fname;
                            $active_transfers[$new_id]['fp'] = $fp;
                            $active_transfers[$new_id]['handle'] = $ch_dl;
                            $slots[$slot] = $new_id;
                        }

                    } else {
                        // ZIP FAILED
                        $slots[$slot] = null;
                        unset($active_transfers[$ch_id]);
                        // The source says the session was scanned for
                        // another site: retrying or streaming won't fix it.
                        if (is_object($decoded) && isset($decoded->code) && $decoded->code === 'session_site_mismatch') {
                            echo "\033[{$max_concurrency}B\033[?25h\n";
                            if (is_resource($mh)) curl_multi_close($mh);
                            throw new \Exception(isset($decoded->message) ? (string) $decoded->message : 'The session was scanned for another site.');
                        }
                        if ($data['job']['attempts'] <= $max_retries) {
                            $pause = 1;
                            if ($http_code == 429 || $http_code == 503) {
                                $ra = $retry_after[$ch_id] ?? null;
                                $pause = self::retry_wait((object) ['headers' => $ra !== null ? ['retry-after' => $ra] : []], $data['job']['attempts']);
                            }
                            echo "\033[{$line}B\r\033[K {$label_num}: Zip Failed (HTTP $http_code). Retrying in {$pause}s...\033[{$line}A";
                            array_unshift($queue, $data['job']);
                            sleep($pause);
                        } else {
                            $fallback_chunks[] = $data['job']['files'];
                            echo "\033[{$line}B\r\033[K {$label_num}: Zip Failed. Added to fallback.\033[{$line}A";
                        }
                    }
                    
                } elseif ($data['state'] === 'DL') {
                    // DOWNLOAD FINISHED
                    $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
                    $curl_error = curl_error($ch);
                    $download_size = curl_getinfo($ch, CURLINFO_SIZE_DOWNLOAD);
                    $expected_size = curl_getinfo($ch, CURLINFO_CONTENT_LENGTH_DOWNLOAD);

                    fflush($data['fp']);
                    fclose($data['fp']);
                    usleep(100000);
                    if (is_resource($ch)) curl_close($ch);
                    
                    $file_exists = file_exists($data['file_path']);
                    $file_size = $file_exists ? filesize($data['file_path']) : 0;
                    
                    if ($http_code >= 200 && $http_code < 300 && empty($curl_error) && $file_size > 0 && ($expected_size == -1 || $download_size == $expected_size)) {
                        // SUCCESS -> TRANSITION TO UNZIP
                        $active_transfers[$ch_id]['state'] = 'UNZIP';
                    } else {
                        // FAILURE
                        $slots[$slot] = null;
                        unset($active_transfers[$ch_id]);
                        if ($file_exists) unlink($data['file_path']);
                        
                        if ($data['job']['attempts'] <= $max_retries) {
                            $err_msg = empty($curl_error) ? "HTTP $http_code" : "Net Error";
                            echo "\033[{$line}B\r\033[K {$label_num}: DL Failed ($err_msg). Retrying...\033[{$line}A";
                            array_unshift($queue, $data['job']);
                        } else {
                            $fallback_chunks[] = $data['job']['files'];
                            echo "\033[{$line}B\r\033[K {$label_num}: DL Failed. Added to fallback.\033[{$line}A";
                        }
                        sleep(1);
                    }
                }
            }

        } while ($running > 0 || !empty($queue) || !empty($active_transfers));

        echo "\033[{$max_concurrency}B"; 
        echo "\033[?25h"; 
        if (is_resource($mh)) curl_multi_close($mh);

        if (!empty($fallback_chunks)) {
            echo "\nProcessing failed chunks via stream fallback...\n";
            foreach ($fallback_chunks as $chunk) {
                foreach ($chunk as $f) {
                    if (!self::local_path_safe($folder, $f->name)) {
                        self::$failures[] = "{$f->name} (unsafe path)";
                        continue;
                    }
                    $ldest = $folder . '/' . $f->name;
                    $ldir = dirname($ldest);
                    if (!is_dir($ldir)) @mkdir($ldir, 0755, true);
                    try {
                        echo "   - Streaming: {$f->name}\n";
                        self::download_file_via_stream($f->name, $ldest);
                        self::$global_bytes_processed += (isset($f->size) ? (float)$f->size : 0);
                    } catch (\Exception $fe) {
                        echo "   - Failed to download: {$f->name}\n";
                        self::$failures[] = "{$f->name} (download failed)";
                    }
                }
            }
        }
    }

    /**
     * Adds a single file object to the ncdu tree by reference.
     * @param array $root The ncdu tree, passed by reference.
     * @param object $file The file object (must have ->name and ->size).
     * @param array $processed_files Pass-by-ref array for de-duplication
     * @return int Returns 1 if a duplicate was skipped, 2 if a dir (trailing /) was skipped, 3 if a dir-total (conflicting) entry was skipped, 0 otherwise.
     */
    private static function add_file_to_ncdu_tree(&$root, $file, &$processed_files) {
        
        if (empty($file->name) || !isset($file->size)) return 0;
        
        // Skip explicitly defined directories (trailing slash)
        if (substr($file->name, -1) === '/') {
            return 2;
        }

        // Deduplication
        if (isset($processed_files[$file->name])) {
            return 1;
        }
        $processed_files[$file->name] = true; 

        $path = $file->name; 
        $parts = explode('/', $path);
        $filename = array_pop($parts); 
        $file_size = (int)$file->size; 
        
        $node = &$root;
        $node['count']++;
        
        $current_parts_path = [];
        
        // Process directories in path
        foreach ($parts as $part) { 
            if (empty($part)) continue;

            if (!isset($node['children'][$part])) { 
                // Create directory node
                $node['children'][$part] = [
                    'name' => $part, 
                    'isdir' => true, 
                    'children' => [], 
                    'asize' => 0, 
                    'dsize' => 0, 
                    'count' => 0
                ];
            } else if ($node['children'][$part]['isdir'] === false) {
                // Conflict: A file exists where a directory is needed.
                // Backtrack counts for the path we just walked.
                $root['count']--;
                $temp_node = &$root;
                foreach ($current_parts_path as $parent_part) {
                    if (isset($temp_node['children'][$parent_part])) {
                        $temp_node = &$temp_node['children'][$parent_part];
                        $temp_node['count']--;
                    }
                }
                return 0;
            }

            // Descend
            $node = &$node['children'][$part];
            $node['count']++;
            $current_parts_path[] = $part;
        }
        
        // Process the final file
        if ($filename !== '') { 
            if (isset($node['children'][$filename]) && $node['children'][$filename]['isdir']) { 
                // Conflict: A directory exists where a file is needed.
                // Backtrack counts.
                $root['count']--;
                $temp_node = &$root;
                foreach ($parts as $part) {
                    if (isset($temp_node['children'][$part])) { 
                        $temp_node = &$temp_node['children'][$part];
                        $temp_node['count']--;
                    }
                }
                return 3;
            } else {
                // Add file node
                if (!isset($node['children'][$filename])) {
                    $node['children'][$filename] = [
                        'name' => $filename, 
                        'asize' => $file_size, 
                        'dsize' => $file_size, 
                        'count' => 1, 
                        'isdir' => false
                    ];
                }
            }
        }
        return 0;
    }

    /**
     * Browses a remote site's file system using ncdu.
     */
    private static function ncdu() {
        // 1. Check for ncdu dependency
        $ncdu_path = trim((string) shell_exec('command -v ncdu'));
        if (empty($ncdu_path)) {
            echo "Error: The 'ncdu' command is not found in your system's PATH.\n";
            echo "Please install ncdu (NCurses Disk Usage) to use this feature.\n";
            exit(1);
        }

        // Note: self::load_config() is already run by main()

        // 2. Backup Token Setup
        if (self::$session_id) {
            self::$backup_token = self::$session_id;
            echo "Reusing backup session: " . self::$backup_token . "\n";
        } else {
            self::$backup_token = self::new_session_id();
        }

        // 3. Fetch Manifest
        $files_manifest_chunks = [];
        try {
            if (self::$session_id) {
                echo "Fetching existing manifest...\n";
                $files_manifest_chunks = self::make_request('/manifest', [], 'GET');
            } else {
                echo "Generating new file manifest (this may take a while)...\n";
                // runManifestGeneration uses self::$exclude_paths automatically
                $files_manifests = self::runManifestGeneration(false);
                $files_manifest_chunks = $files_manifests;
            }
            
            if (!is_array($files_manifest_chunks)) {
                throw new \Exception("Could not fetch or parse manifest. Is the session ID valid?");
            }
        } catch (\Exception $e) {
            echo "Error: {$e->getMessage()}\n";
            if (!self::$session_id) self::cleanupTemporaryFiles();
            exit(1);
        }

        // 4. Download, Process, and Build Tree
        echo "Processing remote file manifest and building tree...\n";
        $ncdu_tree = ['name' => '/', 'isdir' => true, 'children' => [], 'asize' => 0, 'dsize' => 0, 'count' => 0];
        $processed_files = [];

        if (self::$debug) {
            echo "Debug mode enabled, will aggregate files in memory for manifest export.\n";
        }

        // Fetch Parallel - fetch_manifests_parallel uses self::$exclude_paths internally
        list($remote_files_map, $all_remote_files_debug) = self::fetch_manifests_parallel($files_manifest_chunks);
        
        $duplicate_count = 0;
        $skipped_slash_dir_count = 0;
        $skipped_total_dir_count = 0;

        foreach ($remote_files_map as $file) {
             $result = self::add_file_to_ncdu_tree($ncdu_tree, $file, $processed_files);
             if ($result === 1) $duplicate_count++;
             else if ($result === 2) $skipped_slash_dir_count++;
             else if ($result === 3) $skipped_total_dir_count++;
        }

        if ($skipped_slash_dir_count > 0) echo "Ignored " . number_format($skipped_slash_dir_count) . " directory (trailing /) entries.\n";
        if ($skipped_total_dir_count > 0) echo "Ignored " . number_format($skipped_total_dir_count) . " conflicting directory-total entries.\n";
        if ($duplicate_count > 0) echo "Ignored " . number_format($duplicate_count) . " duplicate file entries.\n";
        
        if (self::$debug) {
            $manifest_path = getcwd() . '/.disembark-ncdu-manifest.json';
            file_put_contents($manifest_path, json_encode($all_remote_files_debug, JSON_PRETTY_PRINT));
            echo "Debug: Saved raw manifest to $manifest_path\n";
        }

        // 5. Build the ncdu Tree
        echo "Directory tree build complete.\n";
        $ncdu_json_array = self::format_ncdu_json_array($ncdu_tree);

        // Wrap in the ncdu shell format
        $ncdu_output_data = [
            1, 0, // ncdu JSON format version
            ["progname" => "disembark-cli", "progver" => self::VERSION],
            $ncdu_json_array // The actual tree
        ];
        $json_string = json_encode($ncdu_output_data);

        if (self::$debug) {
            $input_path = getcwd() . '/.disembark-ncdu-input.json';
            file_put_contents($input_path, $json_string);
            echo "Debug: Saved final ncdu input to $input_path\n";
        }

        // 6. Launch ncdu
        echo "Launching ncdu...\n";
        $descriptors = [
            0 => ["pipe", "r"], // stdin
            1 => STDOUT,        // stdout
            2 => STDERR         // stderr
        ];
        $process = proc_open('ncdu -f -', $descriptors, $pipes);
        if (is_resource($process)) {
            fwrite($pipes[0], $json_string);
            fclose($pipes[0]);
            proc_close($process);
        } else {
            echo "Error: Failed to launch ncdu process.\n";
        }

        // 7. Final Cleanup
        if (!self::$session_id) {
            self::cleanupTemporaryFiles();
        }
    }

    /**
     * Displays information about the connected site.
     */
    private static function info() {
        echo "Fetching site information for " . self::$siteUrl . "...\n";

        // Default states
        $status_label = "Unknown";
        $temp_usage = "N/A";
        $db_stats = "N/A";
        $row_stats = "N/A";
        $token_display = self::$token;
        $scan_info = "No recent scan found";
        $session_output = "";

        try {
            // 1. Check Connection & Temp Storage via /backup-size
            $size_response = self::make_request('/backup-size', [], 'GET');
            
            if (isset($size_response->size)) {
                $status_label = "Connected (Valid Credentials)";
                $temp_usage = self::humanFilesize($size_response->size);

                if (self::$cleanup) {
                    try {
                        self::make_request('/cleanup', [], 'GET');
                        $temp_usage .= " (purged)";
                    } catch (\Exception $e) {
                        $temp_usage .= " (purge failed)";
                    }
                }

                // Process Cached Scan Stats
                if (isset($size_response->scan_stats) && is_object($size_response->scan_stats)) {
                    $stats = $size_response->scan_stats;
                    $scan_size = self::humanFilesize($stats->total_size);
                    $scan_count = number_format($stats->total_files);
                    
                    $ts        = (int) $stats->timestamp;
                    $scan_time = date('M j, Y g:i A T', $ts);
                    $time_diff = time() - $ts;
                    $age_str = ($time_diff < 60) ? "Just now" :
                               (($time_diff < 3600) ? floor($time_diff/60) . "m ago" : 
                               (($time_diff < 86400) ? floor($time_diff/3600) . "h ago" : floor($time_diff/86400) . "d ago"));

                    $scan_info = "$scan_count files ($scan_size)\n";
                    $scan_info .= sprintf("%-20s %s (%s)", "", "scanned $scan_time", $age_str);
                }

                if (isset($size_response->sessions) && is_array($size_response->sessions) && !empty($size_response->sessions)) {
                    $session_output .= "\nPrevious Sessions (Resume via --session-id)\n";
                    $session_output .= "----------------------------------------\n";
                    
                    foreach ($size_response->sessions as $session) {
                        // Use PHP date for list speed
                        $date_str = date('M j, Y g:i A', $session->timestamp); 
                        $id_short = $session->token;
                        $chunks   = $session->count;
                        
                        $about = [];
                        if (property_exists($session, 'site')) {
                            $about[] = ($session->site === null || (string) $session->site === '') ? 'whole install' : 'site ' . $session->site;
                        }
                        if (!empty($session->filtered)) {
                            $about[] = 'folders left out';
                        }
                        $session_output .= sprintf("%-20s %-32s (%d chunks)%s\n", $date_str, $id_short, $chunks, $about ? ' ' . implode(', ', $about) : '');
                    }
                }

            } else {
                $status_label = "Connected (Unexpected Response)";
            }

            // 2. Fetch Database Stats
            $db_response = self::make_request('/database', [], 'GET');
            if (is_array($db_response)) {
                 $table_count = count($db_response);
                 $total_bytes = array_sum(array_column($db_response, 'size'));
                 $total_rows = array_sum(array_column($db_response, 'row_count'));
                 
                 $db_stats = number_format($table_count) . " tables (" . self::humanFilesize($total_bytes) . ")";
                 $row_stats = number_format($total_rows) . " rows";
            }

        } catch (\Exception $e) {
            $msg = $e->getMessage();
            if (strpos($msg, '403') !== false) {
                $status_label = "Invalid Credentials (403 Forbidden)";
            } elseif (strpos($msg, '404') !== false) {
                 $status_label = "Plugin not found or API disabled (404)";
            } else {
                $status_label = "Failed";
            }
        }

        // Display Output
        echo "\nSite Information\n";
        echo "----------------\n";
        printf("%-20s %s\n", "Site URL:", self::$siteUrl);
        printf("%-20s %s\n", "Token:", $token_display);
        printf("%-20s %s\n", "Connection Status:", $status_label);
        echo "\nStats\n";
        echo "----------------\n";
        printf("%-20s %s\n", "Temp Storage Used:", $temp_usage);
        printf("%-20s %s\n", "File System:", $scan_info);
        printf("%-20s %s\n", "Database Size:", $db_stats);
        printf("%-20s %s\n", "Total Rows:", $row_stats);
        
        if (!empty($session_output)) {
            echo $session_output;
        }
        
        echo "\n";
    }

    /**
     * Builds an aggregated associative tree from a flat file list for ncdu.
     */
    private static function build_ncdu_tree($all_remote_files) {
        $root = ['name' => '/', 'isdir' => true, 'children' => [], 'asize' => 0, 'dsize' => 0, 'count' => 0];
        foreach ($all_remote_files as $file) {
            if (empty($file->name) || !isset($file->size)) continue;
            
            $path = rtrim($file->name, '/'); // Keep this fix

            $parts = explode('/', $path);
            $filename = array_pop($parts);
            $file_size = (int)$file->size;
            
            $node = &$root;
            // Add file size all the way up the tree
            $node['asize'] += $file_size;
            $node['dsize'] += $file_size;
            $node['count']++;
            
            foreach ($parts as $part) {
                if (empty($part)) continue;
                if (!isset($node['children'][$part])) {
                    // Create dir node if it doesn't exist
                    $node['children'][$part] = ['name' => $part, 'isdir' => true, 'children' => [], 'asize' => 0, 'dsize' => 0, 'count' => 0];
                }
                $node = &$node['children'][$part];
                // Add file size to this dir node
                $node['asize'] += $file_size;
                $node['dsize'] += $file_size;
                $node['count']++;
            }
            
            // Use ($filename !== '') instead of !empty() to correctly handle files named "0"
            if ($filename !== '') {
                // Add the file node
                // Check if a directory with this name already exists (conflicting path)
                if (isset($node['children'][$filename]) && $node['children'][$filename]['isdir']) {
                    // A directory already exists, this is a conflicting file.
                    // For ncdu's purpose, we'll log it as a special file inside.
                    $conflicting_name = $filename . ' (file)';
                    $node['children'][$conflicting_name] = ['name' => $conflicting_name, 'asize' => $file_size, 'dsize' => $file_size, 'count' => 1, 'isdir' => false];
                } else {
                    // This is the normal case: add the file node
                    $node['children'][$filename] = ['name' => $filename, 'asize' => $file_size, 'dsize' => $file_size, 'count' => 1, 'isdir' => false];
                }
            }
        }
        return $root;
    }

    /**
     * Recursively formats the associative tree into ncdu's expected JSON array format.
     */
    private static function format_ncdu_json_array($node) {
        // 1. Create the node metadata object
        $ncdu_node = [
            'name' => $node['name'],
            'asize' => $node['asize'],
            'dsize' => $node['dsize'],
            'count' => $node['count'],
            'isdir' => $node['isdir']
        ];

        // 2. If it's a FILE, just return the object.
        if (!$node['isdir']) {
            return $ncdu_node;
        }

        // 3. If it's a DIRECTORY, create an array.
        $output = [$ncdu_node]; // Start the array with the dir metadata

        // 4. Process children
        if (!empty($node['children'])) {
            $children = array_values($node['children']);
            
            // Sort children: directories first, then alphabetically
            usort($children, function ($a, $b) {
                if ($a['isdir'] !== $b['isdir']) {
                    return $a['isdir'] ? -1 : 1; // Dirs first
                }
                return strcmp($a['name'], $b['name']); // Then by name
            });
            
            // 5. Add recursive results to the output array
            foreach ($children as $child) {
                // This will append EITHER an OBJECT (for a file) OR an ARRAY (for a dir)
                $output[] = self::format_ncdu_json_array($child); 
            }
        }
        
        // 6. Return the full directory array
        return $output;
    }

    /**
     * Initiates a full backup of the connected site.
     */
    private static function backup() {

        // 1. Setup Session / Backup Token
        if (self::$session_id) {
            self::$backup_token = self::$session_id;
            echo "Reusing backup session: " . self::$backup_token . "\n";
        } else {
            self::$backup_token = self::new_session_id();
        }

        $files = [];
        $filtered_files = [];
        $client_side_filtering = false;
        // 2. Manifest Logic
        if (self::$session_id) {
            try {
                echo "Fetching existing manifest...\n";
                $files = self::make_request('/manifest', [], 'GET');
                if (!is_array($files)) {
                    throw new \Exception("Could not fetch or parse existing manifest.");
                }

                // Handle Client-side filtering if exclusions exist on a reused session
                if (!empty(self::$exclude_paths)) {
                    $client_side_filtering = true;
                    echo "Applying client-side exclusions to session manifest...\n";

                    list($remote_files_map, $debug, $report) = self::fetch_manifests_parallel($files);
                    if (!$report['complete']) {
                        throw new \Exception("The source's file list is incomplete (" . implode('; ', $report['problems']) . ").");
                    }
                    $filtered_files = $remote_files_map;
                }
                
                self::displayBackupSummary($client_side_filtering ? [] : $files);
            } catch (\Exception $e) {
                echo "Error fetching manifest: {$e->getMessage()}\n";
                exit(1);
            }
        } else {
            // New Session
            if (!self::$skip_files) {
                // Pass the static preview flag to runPreview
                $files = self::runPreview(self::$preview);
            } else {
                self::displayBackupSummary([]);
                echo "Skipping file analysis as requested.\n";
            }
        }

        if (!empty(self::$exclude_paths)) {
            echo "Excluding the following paths during backup:\n";
            foreach (self::$exclude_paths as $path) echo " - $path\n";
        }
        if (!empty(self::$exclude_tables)) {
            echo "Excluding database tables matching:\n";
            foreach (self::$exclude_tables as $pattern) echo " - $pattern\n";
        }

        echo "Starting backup for " . self::$siteUrl . " using backup token " . self::$backup_token . "\n";
        
        $temp_directory_name = "snapshot-" . time();
        $temp_directory = getcwd() . DIRECTORY_SEPARATOR . $temp_directory_name;
        $local_db_path = $temp_directory . '/database';
        $local_public_path = $temp_directory . '/public';
        
        $domain = preg_replace('/^https?:\/\/(www\.)?/', '', self::$siteUrl);
        $domain = preg_replace('/\//', '_', $domain);
        $final_zip_name = "{$temp_directory_name}-{$domain}.zip";

        // STATS COUNTERS
        $total_items_processed = 0;

        try {
            if (!mkdir($temp_directory, 0755, true)) throw new \Exception("Could not create temp directory $temp_directory.");
            if (!mkdir($local_public_path, 0755, true)) throw new \Exception("Could not create public directory.");

            // Capture source metadata so `disembark restore` knows the origin URL
            // and table prefix to remap. A failure here is non-fatal — restore can
            // still be pointed with --source-url / --source-prefix.
            // Written inside public/ so it lands in the backup zip; the
            // restore step reads it and skips it when deploying files.
            self::write_source_meta($local_public_path);
            // --- CALCULATE GLOBAL TOTALS ---
            $total_db_bytes = 0;
            $database = [];

            // Pre-fetch DB info to calculate total size
            if (!self::$skip_db) {
                $all_tables = self::make_request('/database', [], 'GET');
                if (!is_array($all_tables)) $all_tables = [];

                if (!empty(self::$exclude_tables)) {
                    foreach ($all_tables as $table) {
                        $is_excluded = false;
                        foreach (self::$exclude_tables as $pattern) {
                            if (fnmatch($pattern, $table->table)) {
                                $is_excluded = true;
                                break;
                            }
                        }
                        if (!$is_excluded) $database[] = $table;
                    }
                } else {
                    $database = $all_tables;
                }

                foreach ($database as $tbl) {
                    $total_db_bytes += (isset($tbl->size) ? (float)$tbl->size : 0);
                }
            }
            
            $total_file_bytes = 0;
            if (!self::$skip_files) {
                if (!empty($filtered_files)) {
                     foreach ($filtered_files as $f) {
                         $total_file_bytes += (isset($f->size) ? (float)$f->size : 0);
                         $total_items_processed++;
                     }
                } elseif (!empty($files)) {
                    // $files contains manifest chunks with a 'size' property
                    foreach ($files as $chunk) {
                        $total_file_bytes += isset($chunk->size) ? (float)$chunk->size : 0;
                        $total_items_processed += isset($chunk->count) ? (int)$chunk->count : 0;
                    }
                }
            }

            self::$global_bytes_total = $total_db_bytes + $total_file_bytes;
            self::$global_bytes_processed = 0;
            // -------------------------------

            if (!self::$skip_db) {
                if (!mkdir($local_db_path, 0755, true)) throw new \Exception("Could not create db directory.");
                $db_export_file = $local_public_path . '/database-' . $temp_directory_name . '.sql';
                if (file_put_contents($db_export_file, "/*!40101 SET NAMES utf8mb4 */;\nSET sql_mode='NO_AUTO_VALUE_ON_ZERO';\n") === false) {
                    throw new \Exception("Could not write the database dump at $db_export_file.");
                }
                if (!empty($database)) {
                    // This calls download_db_file -> download_file_direct, which updates global progress
                    self::processDatabaseBackup($database, $db_export_file, $local_db_path);
                    $total_items_processed += count($database); // Add tables to item count
                } else {
                    echo "No database tables to back up.\n";
                }
                rmdir($local_db_path);
            } else {
                echo "Skipping database backup as requested.\n";
            }

            if (!self::$skip_files) {
                echo "Preparing optimized file backup...\n";
                $remote_files_map = [];
                if ($client_side_filtering) {
                    $remote_files_map = $filtered_files;
                } elseif (!empty($files)) {
                    // Fetch using parallel fetcher (uses static excludes)
                    list($remote_files_map, $debug, $report) = self::fetch_manifests_parallel($files);
                    // A backup missing part of the site is not a backup.
                    if (!$report['complete']) {
                        throw new \Exception("The source's file list is incomplete (" . implode('; ', $report['problems']) . ").");
                    }
                }
                if (!empty($remote_files_map)) {
                    $remote_files_map = self::filter_writable_files($remote_files_map, $local_public_path, false);
                }
                $all_files_to_process = array_values($remote_files_map);
                // Update exact count from fetch
                $total_items_processed = count($remote_files_map) + (!self::$skip_db ? count($database) : 0);

                if (!empty($all_files_to_process)) {
                    $large_files_queue = [];
                    $small_files_queue = [];

                    foreach ($all_files_to_process as $file) {
                        $fsize = isset($file->size) ? (int)$file->size : 0;
                        if ($fsize > self::$large_file_threshold) {
                            $large_files_queue[] = $file;
                        } else {
                            $small_files_queue[] = $file;
                        }
                    }

                    if (!empty($large_files_queue)) {
                         self::download_files_parallel($large_files_queue, $local_public_path);
                    }

                    if (!empty($small_files_queue)) {
                        $file_chunks = [];
                        $current_chunk = [];
                        $current_chunk_size = 0;

                        foreach ($small_files_queue as $file) {
                            $fsize = $file->size ?? 0;
                            if (($current_chunk_size + $fsize > self::$file_chunk_max_size) || (count($current_chunk) >= self::$file_chunk_size)) {
                                $file_chunks[] = $current_chunk;
                                $current_chunk = [$file];
                                $current_chunk_size = $fsize;
                            } else {
                                $current_chunk[] = $file;
                                $current_chunk_size += $fsize;
                            }
                        }
                        if (!empty($current_chunk)) $file_chunks[] = $current_chunk;
                        
                        if (!empty($file_chunks)) {
                            self::sync_chunks_parallel($file_chunks, $local_public_path);
                        }

                        self::wait_for_extractions($local_public_path, 120);
                        echo "\n";
                        echo "Small file batches complete.\n";
                    }
                    self::verify_arrived($all_files_to_process, $local_public_path);
                }
            } else {
                echo "Skipping file backup as requested.\n";
            }

            echo "Generating final local zip file: $final_zip_name...\n";
            self::zip_directory($local_public_path, $final_zip_name);

        } catch (\Throwable $e) {
            echo "\033[?25h";
            echo "\nBackup failed: {$e->getMessage()}\n";
            echo "The downloaded files are kept in {$temp_directory}\n";
            if (!self::$session_id) self::cleanupTemporaryFiles();
            exit(1);
        }

        try {
            self::delete_directory($temp_directory);
        } catch (\Exception $e) { }

        if (!self::$session_id) {
            self::cleanupTemporaryFiles();
        } else {
            echo "\nSkipping remote cleanup to preserve UI session files.\n";
        }

        // FINAL SUMMARY
        $final_size = file_exists($final_zip_name) ? filesize($final_zip_name) : 0;
        $had_failures = self::report_failures();
        
        echo $had_failures ? "\nBackup Finished With Errors (the zip is missing the files above)\n" : "\nBackup Completed Successfully\n";
        echo "-----------------------------\n";
        printf("%-15s %s\n", "File Name:", $final_zip_name);
        printf("%-15s %s\n", "Total Size:", self::humanFilesize($final_size));
        printf("%-15s %s\n", "Items:", number_format($total_items_processed));
        echo "\n";
        if ($had_failures) {
            exit(1);
        }
    }

    /**
     * Restores a local snapshot (produced by `disembark backup`) into a
     * connected destination site: preflight -> snapshot -> upload+deploy files
     * -> import DB (prefix-remapped) -> serialize-aware URL search/replace ->
     * finalize. A rollback point is saved first so the import can be undone.
     */
    /**
     * Why a backup can't be restored into one site, or null: it holds a
     * whole multisite network (its blogs and sitemeta tables under one
     * prefix, or a profile saying so with no single site chosen) or a whole
     * WP Freighter install (its bootstrap, wp-content/freighter.php).
     */
    private static function whole_install_backup($public_dir, $sql_file, $meta) {
        $scoped  = is_object($meta) && !empty($meta->scope);
        $install = is_object($meta) && isset($meta->install) ? $meta->install : (is_object($meta) && isset($meta->profile->install) ? $meta->profile->install : null);
        $kind    = '';
        if (!$scoped && is_object($install) && !empty($install->kind)) {
            $kind = (string) $install->kind;
        }
        // A v3 source names the install in its profile, null for a plain
        // site: then a leftover freighter.php (WP Freighter deleted, its
        // bootstrap left behind) says nothing.
        $named   = is_object($meta) && (property_exists($meta, 'install') || (isset($meta->profile) && is_object($meta->profile) && property_exists($meta->profile, 'install')));
        $tenants = false;
        if ($kind === '' && !$scoped && $sql_file && is_readable($sql_file)) {
            $seen = [];
            $h = fopen($sql_file, 'r');
            while ($h && ($line = fgets($h, 8192)) !== false) {
                if (stripos($line, 'CREATE TABLE') === false) {
                    continue;
                }
                if (!$tenants && preg_match('/CREATE\s+TABLE(?:\s+IF\s+NOT\s+EXISTS)?\s+`?stacked_\d+_/i', $line)) {
                    $tenants = true;
                }
                if (preg_match('/CREATE\s+TABLE(?:\s+IF\s+NOT\s+EXISTS)?\s+`?([A-Za-z0-9_$]*?)(blogs|sitemeta)`?\s*\(/i', $line, $m)) {
                    $seen[strtolower($m[1])][strtolower($m[2])] = true;
                    if (count($seen[strtolower($m[1])]) === 2) {
                        $kind = 'multisite';
                        break;
                    }
                }
            }
            if ($h) {
                fclose($h);
            }
        }
        // No profile to go by (an older backup): the bootstrap counts only
        // with WP Freighter itself or its tenants' tables alongside, as the
        // plugin judges a live install.
        if ($kind === '' && !$scoped && !$named && is_file($public_dir . '/wp-content/freighter.php')
            && (is_dir($public_dir . '/wp-content/plugins/wp-freighter') || $tenants)) {
            $kind = 'freighter';
        }
        if ($kind === 'multisite') {
            return 'This backup holds a whole multisite network. Moving a whole network as one isn\'t supported yet: back up one site of it with --site=<id> (or the site\'s own address), or pull the site you want with wp disembark pull --site=<id>.';
        }
        if ($kind === 'freighter') {
            return 'This backup holds a whole WP Freighter install. Moving a whole install as one isn\'t supported yet: back up one tenant with --site=<id>, or pull it with wp disembark pull --site=<id>.';
        }
        return null;
    }

    private static function restore($folder) {
        if (!is_dir($folder)) {
            echo "Error: folder not found: $folder\n";
            exit(1);
        }

        // Locate the site files. A backup snapshot keeps them under public/.
        $public_dir = $folder . '/public';
        if (!is_dir($public_dir)) {
            if (is_dir($folder . '/wp-includes') || is_dir($folder . '/wp-content')) {
                $public_dir = $folder;
            } else {
                echo "Error: no 'public' directory in $folder. Point restore at a 'disembark backup' snapshot.\n";
                exit(1);
            }
        }

        // Locate the SQL dump (written into public/ by backup). More than one
        // is ambiguous — refuse rather than guess which state to restore.
        // A `disembark sync` mirror (its files at the folder's root) keeps
        // its own dump as database.sql: that one wins, and a database-*.sql
        // beside it is a file the source happened to have at its root
        // (never uploaded as a site file either).
        $is_mirror = $public_dir === $folder;
        if ($is_mirror && is_file($folder . '/database.sql')) {
            $sql_files = [$folder . '/database.sql'];
            foreach (glob($folder . '/database-*.sql') ?: [] as $stray) {
                echo "Note: using the mirror's database.sql; " . basename($stray) . " at the root is left out.\n";
            }
        } else {
            $sql_files = glob($public_dir . '/database-*.sql') ?: [];
            if (empty($sql_files) && !$is_mirror) {
                $sql_files = glob($folder . '/database-*.sql') ?: [];
            }
        }
        if (count($sql_files) > 1) {
            echo "Error: multiple database dumps found in the snapshot — remove the extras or re-run 'disembark backup':\n";
            foreach ($sql_files as $f) {
                echo "  - $f\n";
            }
            exit(1);
        }
        $sql_file = !empty($sql_files) ? $sql_files[0] : null;

        // Resolve source metadata: --source-* overrides, else disembark-source.json.
        $source_home   = self::$source_url;
        $source_prefix = self::$source_prefix;
        $meta_file     = $folder . '/disembark-source.json';
        if (!file_exists($meta_file) && file_exists($public_dir . '/disembark-source.json')) {
            $meta_file = $public_dir . '/disembark-source.json';
        }
        if (file_exists($meta_file)) {
            $meta = json_decode(file_get_contents($meta_file));
            if (is_object($meta)) {
                if (!$source_home && !empty($meta->home_url))  $source_home   = rtrim($meta->home_url, '/');
                if (!$source_prefix && !empty($meta->db_prefix)) $source_prefix = $meta->db_prefix;
            }
        }

        // A whole multisite network or WP Freighter install can't be restored
        // into one site (the plugin refuses it too, but a CLI restore places
        // files before the database arrives): stopped before anything changes.
        if ($why = self::whole_install_backup($public_dir, $sql_file, isset($meta) && is_object($meta) ? $meta : null)) {
            echo "Error: {$why} Nothing was changed.\n";
            exit(1);
        }

        $import_id = self::new_session_id();

        // Preflight the destination.
        echo "Preflighting destination " . self::$siteUrl . "...\n";
        try {
            $pre = self::make_request('/import/preflight', ['import_id' => $import_id], 'POST');
        } catch (\Exception $e) {
            $pre = null;
        }
        if (!is_object($pre)) {
            echo "Error: preflight failed.\n";
            exit(1);
        }
        // v3 refuses a whole-site restore into a subsite or tenant reached
        // directly; stop before asking anything.
        if (!empty($pre->refused)) {
            echo "Error: " . $pre->refused . "\n";
            exit(1);
        }
        // What the destination supports: v3 announces pacing (steps that
        // work in pieces) and resumable steps (safe to resend).
        $caps = clone $pre;
        unset($caps->disembark_token);
        self::$source_caps = $caps;
        $dest_home   = rtrim($pre->home_url ?? self::$siteUrl, '/');
        $dest_prefix = $pre->db_prefix ?? '';
        // Plugins from 2.9 report the largest upload chunk the host accepts.
        if (!empty($pre->upload_chunk_bytes) && (int) $pre->upload_chunk_bytes > 0) {
            self::$upload_chunk_bytes = (int) $pre->upload_chunk_bytes;
            self::$upload_limit_known = true;
        }

        // The DB import overwrites users/usermeta (killing any application
        // password) but the plugin preserves its token across the import. So
        // pin auth to that token for every step after this, regardless of how we
        // connected — otherwise post-import calls (search-replace, finalize)
        // would 403.
        $was_app_password = !empty(self::$username);
        if (!empty($pre->disembark_token)) {
            self::$token    = $pre->disembark_token;
            self::$username = null;
            self::$password = null;
            if ($was_app_password) {
                // Persist the pinned token so a later --rollback (a fresh
                // process) can still authenticate after the import killed the
                // application password.
                self::save_site_token(self::$siteUrl, $pre->disembark_token);
            }
        } elseif ($was_app_password && empty(self::$token)) {
            echo "Error: the destination did not return its Disembark token. With application-password\n";
            echo "auth alone, access is lost mid-restore (the database import replaces wp_users) and a\n";
            echo "rollback would be impossible. Update Disembark on the destination, or connect with\n";
            echo "the site token instead: disembark connect " . self::$siteUrl . " <token>\n";
            exit(1);
        }

        // Summarise and confirm — this overwrites the destination.
        echo "\n";
        echo "About to RESTORE into: " . self::$siteUrl . "\n";
        echo "  Source folder : $folder\n";
        echo "  Files         : " . (!self::$skip_files ? "yes" : "skipped") . "\n";
        echo "  Database      : " . (!self::$skip_db && $sql_file ? basename($sql_file) : (self::$skip_db ? "skipped" : "none found")) . "\n";
        if ($source_home) {
            echo "  URL replace   : $source_home  ->  $dest_home\n";
        } else {
            echo "  URL replace   : (none - pass --source-url to rewrite URLs)\n";
        }
        if ($source_prefix && $dest_prefix && $source_prefix !== $dest_prefix) {
            echo "  Prefix remap  : $source_prefix  ->  $dest_prefix\n";
        }
        echo "  This OVERWRITES the destination database and files. A rollback point is saved first.\n\n";
        if (!self::$assume_yes) {
            echo "Type 'yes' to continue: ";
            $line = trim(fgets(STDIN));
            if (strtolower($line) !== 'yes') {
                echo "Aborted.\n";
                exit(1);
            }
        }

        // Save a rollback point. Abort while the destination is still intact
        // if the snapshot can't be verified — without it there is no undo.
        echo "Creating rollback snapshot...\n";
        try {
            $from_label = $source_home ? preg_replace('#^https?://#', '', rtrim($source_home, '/')) : basename(rtrim($folder, '/'));
            $snap = self::paced_request('/import/snapshot', ['import_id' => $import_id, 'label' => 'Before restore from ' . $from_label . ' (Disembark CLI)'], 'Rollback snapshot');
        } catch (\Exception $e) {
            $snap = null;
        }
        if (!is_object($snap) || empty($snap->rollback_id)) {
            echo "Error: could not create the rollback snapshot. Aborting — nothing was changed.\n";
            exit(1);
        }
        echo "  Rollback id: $import_id\n";
        echo "  (undo at any point with: disembark restore " . self::$siteUrl . " --rollback=$import_id)\n";

        $zip_tmp = null;
        try {
            // Files: zip the tree, upload, deploy in batches.
            if (!self::$skip_files) {
                echo "Packaging files...\n";
                $zip_tmp   = rtrim(sys_get_temp_dir(), DIRECTORY_SEPARATOR) . '/disembark-restore-' . $import_id . '.zip';
                $rel_files = [];
                self::zip_directory_collect($public_dir, $zip_tmp, $rel_files);
                echo "Uploading " . count($rel_files) . " files (" . self::humanFilesize(filesize($zip_tmp)) . ")...\n";
                self::upload_zip_to_staging($zip_tmp, $import_id);
                @unlink($zip_tmp);
                $zip_tmp = null;
                echo "Deploying files...\n";
                $deployed      = 0;
                $deploy_errors = [];
                foreach (array_chunk($rel_files, 500) as $batch) {
                    $dep = self::make_request('/import/deploy-files', ['import_id' => $import_id, 'files' => $batch], 'POST');
                    if (is_object($dep) && isset($dep->deployed)) {
                        $deployed += (int) $dep->deployed;
                    }
                    if (is_object($dep) && !empty($dep->errors)) {
                        $deploy_errors = array_merge($deploy_errors, (array) $dep->errors);
                    }
                }
                // Every file sent must land — proceeding to wipe the database
                // after a partial (or zero) deploy would leave a broken hybrid.
                if ($deployed < count($rel_files)) {
                    $detail = !empty($deploy_errors) ? ' First error: ' . $deploy_errors[0] : '';
                    throw new \Exception("only {$deployed} of " . count($rel_files) . " files deployed.{$detail}");
                }
                echo "  Deployed $deployed files.\n";
            }

            // Database: stage the dump on the server (chunked, so a large dump
            // never needs one giant request), then import it there. The server
            // applies the transforms per statement (prefix remap on identifiers,
            // DROP-before-CREATE) — safer than rewriting the whole dump here,
            // where INSERT values could be corrupted.
            if (!self::$skip_db && $sql_file) {
                echo "Uploading database (" . self::humanFilesize(filesize($sql_file)) . ")...\n";
                // Staged as database-import.sql: the server's deploy step skips
                // database-*.sql, so the dump can never land in the web root.
                self::upload_file_to_staging($sql_file, 'database-import.sql', $import_id);
                echo "Importing database...\n";
                $payload = ['import_id' => $import_id, 'sql_file' => 'database-import.sql'];
                if ($source_prefix && $dest_prefix && $source_prefix !== $dest_prefix) {
                    $payload['old_prefix'] = $source_prefix;
                    $payload['new_prefix'] = $dest_prefix;
                }
                $res = self::paced_request('/import/import-staged-sql', $payload, 'Importing database');
                if (is_object($res)) {
                    $sql_errors = !empty($res->errors) && is_array($res->errors) ? $res->errors : [];
                    if (!empty($sql_errors) || !empty($res->database_unchanged)) {
                        $err_count = count($sql_errors);
                        $first_err = $err_count > 0 ? substr((string) $sql_errors[0], 0, 200) : 'unknown error';
                        $detail    = !empty($res->database_unchanged)
                            ? 'The destination database was not changed: the import works on copies of the tables and only swaps them in when every statement succeeds.'
                            : 'Stopped before rewriting URLs.';
                        throw new \Exception("The database import reported {$err_count} error(s) (first: {$first_err}). {$detail}");
                    }
                    echo "  " . ($res->statements_executed ?? 0) . " statements executed.\n";
                }

                // Cross-prefix migration: remap the prefix stored inside the data
                // (usermeta capabilities, options user_roles) so users keep roles.
                if ($source_prefix && $dest_prefix && $source_prefix !== $dest_prefix) {
                    echo "Remapping table prefix in data ($source_prefix -> $dest_prefix)...\n";
                    $rp = self::make_request('/import/remap-prefix', ['import_id' => $import_id, 'old_prefix' => $source_prefix, 'new_prefix' => $dest_prefix], 'POST');
                    if (is_object($rp)) {
                        echo "  " . ($rp->keys_changed ?? 0) . " keys remapped.\n";
                    }
                }

                if ($source_home && $dest_home && $source_home !== $dest_home) {
                    echo "Rewriting URLs ($source_home -> $dest_home)...\n";
                    $sr = self::paced_request('/import/search-replace', ['import_id' => $import_id, 'from' => $source_home, 'to' => $dest_home], 'Rewriting URLs');
                    if (is_object($sr)) {
                        echo "  " . ($sr->rows_changed ?? 0) . " rows / " . ($sr->cells_changed ?? 0) . " cells updated across " . ($sr->tables ?? 0) . " tables.\n";
                        if (!empty($sr->files_rewritten)) {
                            echo "  Rewrote the old address in " . (int) $sr->files_rewritten . " file(s) under uploads.\n";
                        }
                        if (!empty($sr->files_too_big_total)) {
                            echo "  ! " . (int) $sr->files_too_big_total . " file(s) under uploads mention $source_home but are over 5 MB, so left as is: " . implode(', ', array_slice((array) ($sr->files_too_big ?? []), 0, 8)) . ((int) $sr->files_too_big_total > 8 ? ', ...' : '') . "\n";
                        }
                        if (!empty($sr->files_mentioning_total)) {
                            echo "  " . (int) $sr->files_mentioning_total . " theme or plugin file(s) still mention $source_home (left as is): " . implode(', ', array_slice((array) ($sr->files_mentioning_source ?? []), 0, 8)) . ((int) $sr->files_mentioning_total > 8 ? ', ...' : '') . "\n";
                        }
                    }
                }
            }

            echo "Finalizing...\n";
            self::make_request('/import/finalize', ['import_id' => $import_id], 'POST');
        } catch (\Exception $e) {
            if ($zip_tmp) {
                @unlink($zip_tmp);
            }
            echo "\nError: restore failed: {$e->getMessage()}\n";
            echo "The destination may be partially modified. Undo with:\n";
            echo "  disembark restore " . self::$siteUrl . " --rollback=$import_id\n";
            exit(1);
        }

        echo "\nRestore complete. Rollback id: $import_id\n";
        echo "To undo:  disembark restore " . self::$siteUrl . " --rollback=$import_id\n";
    }

    /**
     * Undo a prior restore using its saved rollback point.
     */
    private static function restore_rollback($id) {
        echo "Rolling back import $id on " . self::$siteUrl . "...\n";
        self::source_caps(); // a v3 destination rolls back in pieces
        $payload = ['import_id' => $id];
        try {
            $res = self::paced_request('/import/rollback', $payload, 'Rolling back', true);
        } catch (\Exception $e) {
            // Restore points made after this one would be left half undone
            // (3.0.1 refuses that): undo them first, newest first, if asked.
            $err = self::$last_error;
            if (!$err || $err['code'] !== 'later_points_exist') {
                echo "Error: rollback failed: " . ($err && $err['message'] !== '' ? $err['message'] : $e->getMessage()) . "\n";
                echo "Nothing more was changed by this command; run it again to retry.\n";
                exit(1);
            }
            echo preg_replace('/ Roll back with later: true.*$/s', '', $err['message']) . "\n";
            if (!self::$assume_yes) {
                echo "Roll back the later restore point(s) first, newest first, then this one? Type 'yes' to continue: ";
                $line = trim((string) fgets(STDIN));
                if (strtolower($line) !== 'yes') {
                    echo "Aborted. Nothing was changed.\n";
                    exit(1);
                }
            }
            try {
                $res = self::paced_request('/import/rollback', $payload + ['later' => true], 'Rolling back');
            } catch (\Exception $e2) {
                echo "Error: rollback failed: {$e2->getMessage()}\n";
                echo "Run it again to carry on from where it stopped.\n";
                exit(1);
            }
        }
        if (is_object($res) && !empty($res->warnings) && is_array($res->warnings)) {
            foreach ($res->warnings as $warning) {
                echo "Warning: {$warning}\n";
            }
        }
        $errors = (is_object($res) && !empty($res->errors) && is_array($res->errors)) ? $res->errors : [];
        if (!is_object($res) || empty($res->success) || !empty($errors)) {
            if (!empty($errors)) {
                echo "Error: rollback reported " . count($errors) . " problem(s):\n";
                foreach (array_slice($errors, 0, 10) as $err) {
                    echo "  - {$err}\n";
                }
                if (count($errors) > 10) {
                    echo "  - ...and " . (count($errors) - 10) . " more\n";
                }
            } else {
                echo "Error: rollback did not succeed (response: " . json_encode($res) . ").\n";
            }
            exit(1);
        }
        echo "Rollback complete. Tables restored: " . ($res->tables_restored ?? '?') . ", files restored: " . ($res->files_restored ?? '?') . ".\n";
    }

    /**
     * Zips every file under $source (recursively), collecting the archive-
     * relative paths. Skips ALL database dumps (database-*.sql anywhere, any
     * .sql at the root such as a sync mirror's database.sql; a deployed
     * dump would be a guessable-URL full-database disclosure), Disembark's own
     * snapshot metadata, and wp-config.php (the server never deploys it, and
     * the source's credentials don't belong in the destination's staging).
     */
    private static function zip_directory_collect($source, $zip_path, &$rel_files) {
        $rel_files = [];
        $zip = new \ZipArchive();
        if ($zip->open($zip_path, \ZipArchive::CREATE | \ZipArchive::OVERWRITE) !== true) {
            throw new \Exception("Could not create zip at $zip_path");
        }
        $source = rtrim($source, DIRECTORY_SEPARATOR);
        $keep   = [];
        $nested = [];
        $it = new \RecursiveIteratorIterator(
            new \RecursiveDirectoryIterator($source, \RecursiveDirectoryIterator::SKIP_DOTS),
            \RecursiveIteratorIterator::SELF_FIRST
        );
        foreach ($it as $file) {
            // Never a symlink: it could carry a file from outside the folder.
            if ($file->isLink() || $file->isDir()) {
                continue;
            }
            $path = $file->getPathname();
            $base = basename($path);
            $rel  = ltrim(substr($path, strlen($source)), DIRECTORY_SEPARATOR);
            $rel  = str_replace('\\', '/', $rel);
            $low_base = strtolower($base);
            $low_rel  = strtolower($rel);
            if ($low_base === 'disembark-source.json' || $low_base === 'wp-config.php' || $low_rel === 'restore.zip') {
                continue;
            }
            // Quiet mode mu-plugin belongs to the site it was turned on for.
            if ($low_base === 'disembark-quiet-mode.php' && strpos($low_rel, 'mu-plugins/') !== false) {
                continue;
            }
            // Database dumps never go in the upload: Disembark's database-*.sql
            // or *.(db|sql).txt anywhere, host dumps in wp-content/, and any
            // .sql / .sql.gz / .sql.part at the root.
            if (preg_match('/^database-.*\.sql$/i', $base)
                || preg_match('/\.(?:db|sql)\.txt$/i', $base)
                || preg_match('#^wp-content/(?:mysql\.sql|mysqldb-dump\.sql(?:\.gz)?)$#i', $rel)
                || (strpos($rel, '/') === false && preg_match('/\.sql(?:\.gz|\.part)?$/i', $rel))) {
                continue;
            }
            // Disembark's own working folders (sync state, chunks, uploads
            // storage), at any depth: another sync mirror inside this folder
            // (a subsite address once synced to example.com/shop) keeps its
            // own there.
            if (preg_match('#(?:^|/)(?:\.disembark-db-parts|\.disembark-manifests)/#', $low_rel)
                || strpos($low_rel, '_chunks/') === 0
                || preg_match('#^(?:wp-content/)?uploads/(?:sites/\d+/)?disembark/#i', $rel)) {
                if (preg_match('#^(.+)/\.disembark-manifests/sync-state\.json$#', $rel, $m)) {
                    $nested[] = $m[1] . '/';
                }
                continue;
            }
            $keep[] = [$path, $rel];
        }
        // A folder holding another sync mirror isn't this site's: leave it,
        // its database.sql and its source record out of the upload.
        $nested = array_unique($nested);
        foreach ($nested as $dir) {
            echo "Leaving out $dir: it holds another 'disembark sync' mirror, not this site's files.\n";
        }
        foreach ($keep as $entry) {
            list($path, $rel) = $entry;
            foreach ($nested as $dir) {
                if (strpos($rel, $dir) === 0) {
                    continue 2;
                }
            }
            if (!$zip->addFile($path, $rel)) {
                throw new \Exception("Could not add $rel to the upload zip.");
            }
            $rel_files[] = $rel;
        }
        if (!$zip->close()) {
            @unlink($zip_path);
            throw new \Exception("Could not write the upload zip at $zip_path (is the disk full?).");
        }
    }

    /**
     * Uploads a zip to staging. Small zips go in one POST; larger ones are sent
     * in chunks (so a multi-GB site never needs a single huge request or the
     * whole file in memory) and reassembled + extracted server-side.
     */
    private static function upload_zip_to_staging($zip_path, $import_id) {
        // One request when the archive fits in one chunk. A 2.9+ destination
        // reports its own limit; older ones keep the 40MB single-request cutoff.
        $chunk_threshold = self::$upload_limit_known ? self::$upload_chunk_bytes : 40 * 1024 * 1024;

        if (filesize($zip_path) <= $chunk_threshold) {
            self::post_multipart('/import/upload-zip', self::upload_fields($import_id), 'restore.zip', file_get_contents($zip_path));
            return;
        }

        self::upload_file_to_staging($zip_path, 'restore.zip', $import_id);
        self::paced_request('/import/extract-zip', ['import_id' => $import_id, 'file_path' => 'restore.zip'], 'Unpacking');
    }

    /**
     * Uploads any local file into the import's staging area as $remote_name,
     * streamed in chunks to /import/upload-chunk so no single request carries
     * the whole file (and the file is never fully read into memory).
     */
    private static function upload_file_to_staging($local_path, $remote_name, $import_id) {
        $size         = filesize($local_path);
        $chunk_bytes  = self::$upload_chunk_bytes; // 20MB unless the destination asks for less
        $total_chunks = max(1, (int) ceil($size / $chunk_bytes));
        $fh = fopen($local_path, 'rb');
        if (!$fh) {
            throw new \Exception("Could not open $local_path for chunked upload.");
        }
        for ($i = 0; $i < $total_chunks; $i++) {
            $data = fread($fh, $chunk_bytes);
            if ($data === false) {
                fclose($fh);
                throw new \Exception("Failed reading $local_path at chunk $i.");
            }
            self::post_multipart(
                '/import/upload-chunk',
                self::upload_fields($import_id, ['file_path' => $remote_name, 'chunk_index' => $i, 'total_chunks' => $total_chunks]),
                $remote_name,
                $data
            );
            if ($total_chunks > 1) {
                echo "\r  Uploaded chunk " . ($i + 1) . "/$total_chunks";
            }
        }
        fclose($fh);
        if ($total_chunks > 1) {
            echo "\n";
        }
    }

    /**
     * Common multipart fields for upload requests: import_id, plus the token for
     * token-auth sites (app-password auth rides the Authorization header).
     */
    private static function upload_fields($import_id, $extra = []) {
        $fields = ['import_id' => $import_id];
        if (!empty(self::$token)) {
            $fields['token'] = self::$token;
        }
        return array_merge($fields, $extra);
    }

    /**
     * POSTs multipart/form-data with a set of text fields plus one file part
     * (so PHP populates $_FILES and the server's is_uploaded_file() passes).
     * Transient failures (connection drops, 502/503/504 gateway hiccups) are
     * retried with backoff — chunked uploads shouldn't die on one bad proxy
     * response mid-transfer.
     */
    private static function post_multipart($endpoint, $fields, $filename, $file_bytes) {
        $url      = self::rest_url($endpoint);
        $boundary = '----disembark' . bin2hex(random_bytes(8));
        $eol      = "\r\n";

        $body = '';
        foreach ($fields as $name => $value) {
            $body .= "--$boundary$eol";
            $body .= "Content-Disposition: form-data; name=\"$name\"$eol$eol$value$eol";
        }
        $body .= "--$boundary$eol";
        $body .= "Content-Disposition: form-data; name=\"file\"; filename=\"$filename\"$eol";
        $body .= "Content-Type: application/octet-stream$eol$eol";
        $body .= $file_bytes;
        $body .= "$eol--$boundary--$eol";

        $headers = ['Content-Type' => "multipart/form-data; boundary=$boundary"] + self::api_headers();
        $options  = ['verify' => false, 'timeout' => 1800, 'useragent' => self::$user_agent];

        $attempts = 3;
        for ($attempt = 1; $attempt <= $attempts; $attempt++) {
            try {
                $response = \WpOrg\Requests\Requests::post($url, $headers, $body, $options);
            } catch (\WpOrg\Requests\Exception $e) {
                if ($attempt < $attempts) {
                    echo "\n  Upload attempt $attempt failed ({$e->getMessage()}); retrying...\n";
                    sleep($attempt * 5);
                    continue;
                }
                throw new \Exception("upload failed: {$e->getMessage()}");
            }
            // A files deploy just gave the destination plain permalinks (its
            // .htaccess or database): /wp-json/ answers with a page now.
            // Carry on through ?rest_route=, as make_request() does, once.
            if (self::$rest_style !== 'rest_route' && in_array($response->status_code, [200, 404], true) && self::is_html_page($response)) {
                self::$rest_style = 'rest_route';
                $url = self::rest_url($endpoint);
                echo "\n      The site answers /wp-json/ with a page (plain permalinks): carrying on through ?rest_route=.\n";
                $attempt--;
                continue;
            }
            if ($response->status_code === 200) {
                return json_decode($response->body);
            }
            if (in_array($response->status_code, [502, 503, 504], true) && $attempt < $attempts) {
                echo "\n  Upload got HTTP {$response->status_code}; retrying...\n";
                sleep($attempt * 5);
                continue;
            }
            echo "Error: upload failed. HTTP {$response->status_code}: " . substr($response->body, 0, 300) . "\n";
            throw new \Exception("upload failed");
        }
    }

    private static function sites() {
        $homeDir = getenv('HOME');
        if (!$homeDir) {
            echo "Error: Unable to determine the home directory.\n";
            exit(1);
        }

        $filePath = $homeDir . '/.disembark';
        $data = [];
        if (file_exists($filePath)) {
            $jsonContents = file_get_contents($filePath);
            $data = json_decode($jsonContents);
            if (!is_array($data)) {
                if (is_object($data)) {
                    $data = [$data];
                } else {
                    echo "Error: Invalid data in $filePath.\n";
                    exit(1);
                }
            }
        } else {
            echo "No configuration file found at $filePath. No sites connected.\n";
            exit(0);
        }

        if (empty($data)) {
            echo "No sites connected.\n";
        } else {
            echo "Connected sites:\n";
            foreach ($data as $entry) {
                if (is_object($entry) && isset($entry->siteUrl)) {
                    echo "- {$entry->siteUrl}\n";
                } else {
                    echo "- (Invalid entry in config file)\n";
                }
            }
        }
    }

    private static function version() {
        $version = self::VERSION;
        echo "Disembark CLI v{$version}\n";
    }

    private static function upgrade() {
        echo "Checking for updates...\n";
        $current_version = self::VERSION;

        $latest_version_cmd = "curl -sL -o /dev/null -w '%{url_effective}' https://github.com/DisembarkHost/disembark-cli/releases/latest | sed 's#.*/v##'";
        $latest_version = trim(shell_exec($latest_version_cmd));
        if (empty($latest_version) || !preg_match('/^\d+\.\d+\.\d+/', $latest_version)) {
            echo "Error: Could not fetch the latest version information or invalid version format received ('{$latest_version}').\n";
            exit(1);
        }

        if (version_compare($latest_version, $current_version, '>')) {
            echo "New version {$latest_version} available. Upgrading from {$current_version}...\n";
            $pharPath = \Phar::running(false);
            if (empty($pharPath)) {
                $scriptPath = realpath($_SERVER['argv'][0]);
                if ($scriptPath && is_file($scriptPath)) {
                    $pharPath = $scriptPath;
                    echo "Info: Determined script path as {$pharPath}.\n";
                } else {
                    echo "Error: Could not determine the path of the running script. Upgrade failed.\n";
                    echo "Please download the latest version manually from:\n";
                    echo "https://github.com/DisembarkHost/disembark-cli/releases/latest/download/disembark.phar\n";
                    exit(1);
                }
            }

            $downloadUrl = 'https://github.com/DisembarkHost/disembark-cli/releases/latest/download/disembark.phar';
            $tmpFile = tempnam(sys_get_temp_dir(), 'disembark-upgrade-');
            if ($tmpFile === false) {
                echo "Error: Could not create a temporary file. Upgrade failed.\n";
                exit(1);
            }

            echo "Downloading new version from {$downloadUrl}...\n";
            $download_cmd = sprintf("curl -sL '%s' -o '%s'", $downloadUrl, $tmpFile);
            shell_exec($download_cmd);
            if (!file_exists($tmpFile) || filesize($tmpFile) === 0) {
                echo "Error: Failed to download the new version. File is empty or does not exist at {$tmpFile}. Upgrade failed.\n";
                if (file_exists($tmpFile)) unlink($tmpFile);
                exit(1);
            }

            chmod($tmpFile, 0755);
            $move_cmd = sprintf("mv '%s' '%s'", $tmpFile, $pharPath);
            exec($move_cmd, $output, $return_var);
            if ($return_var !== 0) {
                echo "Error: Failed to replace the current script at {$pharPath}.\n";
                echo "You might need to run the command with sufficient permissions (e.g., using sudo):\n";
                echo "sudo disembark upgrade\n";
                if (file_exists($tmpFile)) {
                    unlink($tmpFile);
                }
                exit(1);
            }


            echo "Upgrade complete. You are now on version {$latest_version}.\n";
        } else {
            echo "You are already using the latest version ({$current_version}).\n";
        }
    }

